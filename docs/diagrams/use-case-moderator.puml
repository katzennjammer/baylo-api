@startuml use-case-moderator
' ============================================================================
'  Baylo - Admin Console: MODERATOR use cases
'  The minimum staff role. Admin and Super Admin inherit all of these, so this
'  is a strict subset of what they can reach.
'  Source: baylo-api/src/app/admin/layout.tsx + requireRole("MODERATOR")
' ============================================================================

left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam nodesep 12
skinparam ranksep 55
skinparam ArrowThickness 1
skinparam usecase {
  BackgroundColor #F7F9F7
  BorderColor #1f6b43
  ArrowColor #536159
  FontColor #17201b
}
skinparam actor {
  BackgroundColor #2e7d32
  BorderColor #17201b
  FontColor #17201b
}
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FDFEFD
  BorderColor #1f6b43
  FontColor #17201b
}

title Baylo Admin Console - MODERATOR

actor "Moderator" as MOD

rectangle "Baylo Admin Console" {
  package "Moderation" {
    usecase "View report queue\n(filter status/type/reason)" as UC_QUEUE
    usecase "Inspect a report\n(content, context, history)" as UC_REPORT
    usecase "Claim / action / dismiss\n(a reason is required)" as UC_RESOLVE
    usecase "Hide / restore a listing" as UC_HIDE
  }
  package "Trust & Safety" {
    usecase "Review ID checks\n(approve / reject)" as UC_ID
  }
  package "Anomalies & Appeals" {
    usecase "Handle value anomalies\n(approve / reject value)" as UC_VAL
    usecase "Decide appeals\n(uphold / overturn)" as UC_APPEAL
  }
  package "Catalogue & Safety Zones" {
    usecase "Browse / filter listings" as UC_LIST
    usecase "Manage Safe-Zone hubs\n(create / edit / activate)" as UC_HUB
  }
  package "Governance" {
    usecase "Reverse trade reward" as UC_REV
    usecase "Read / filter audit log" as UC_AUDIT
    usecase "View dashboard overview" as UC_DASH
    usecase "Sign out / switch account" as UC_SIGNOUT
  }
}

MOD --> UC_QUEUE
MOD --> UC_REPORT
MOD --> UC_RESOLVE
MOD --> UC_HIDE
MOD --> UC_ID
MOD --> UC_VAL
MOD --> UC_APPEAL
MOD --> UC_LIST
MOD --> UC_HUB
MOD --> UC_REV
MOD --> UC_AUDIT
MOD --> UC_DASH
MOD --> UC_SIGNOUT

legend bottom right
  MODERATOR cannot:
  - search / suspend users   (Admin only)
  - change staff roles       (Super Admin only)
endlegend

@enduml
