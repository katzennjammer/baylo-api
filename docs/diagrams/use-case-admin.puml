
@startuml use-case-admin
' ============================================================================
'  Baylo - Admin Console: the ADMIN use cases.
'
'  TWO ROLES EXIST: USER and ADMIN (see Role in @/lib/api-auth.ts:127).
'  There is no MODERATOR and no SUPER_ADMIN tier. "Moderator" appears in prose
'  comments only; it is never a stored role value.
'
'  Every /api/admin route is gated by requireRole("ADMIN"); the /admin layout
'  re-reads the role from the database on every request and redirects a
'  non-ADMIN to /dashboard.
'
'  A plain USER has no use case inside this system: the console is the whole
'  difference between the two roles.
'
'  NAMING: one verb + one noun per use case, no "and". Where a use case has two
'  verbs it is drawn as two use cases. The buttons are the <<include>> steps,
'  not the use cases themselves.
' ============================================================================

left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam nodesep 12
skinparam ranksep 55
skinparam ArrowThickness 1
skinparam usecase {
  BackgroundColor #F7F9F7
  BorderColor #1f6b43
  ArrowColor #536159
  FontColor #17201b
}
skinparam actor {
  BackgroundColor #1d4ed8
  BorderColor #17201b
  FontColor #17201b
}
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FDFEFD
  BorderColor #1f6b43
  FontColor #17201b
}

title Baylo Admin Console - ADMIN use cases
actor "Admin" as ADM
rectangle "Baylo Admin Console (ADMIN only)" {

  package "1. Access & Account" {
    usecase "UC-01\nVerify Admin Session" as UC01
    usecase "UC-02\nAssign User Role" as UC02
    usecase "UC-03\nSign Out" as UC03
  }

  package "2. Monitoring" {
    usecase "UC-04\nView Dashboard" as UC04
    usecase "UC-05\nView Audit Log" as UC05
    usecase "UC-06\nView Review Queue" as UC06
    usecase "UC-42\nView Overall Report" as UC42
    usecase "UC-43\nExport Report" as UC43
  }

  package "3. Reports" {
    usecase "UC-07\nView Report Queue" as UC07
    usecase "UC-08\nClaim Report" as UC08
    usecase "UC-09\nMark Report Actioned" as UC09
    usecase "UC-10\nDismiss Report" as UC10
    usecase "UC-11\nView Report Evidence" as UC11
  }

  package "4. ID Verification" {
    usecase "UC-12\nView ID Verification Queue" as UC12
    usecase "UC-13\nApprove ID Verification" as UC13
    usecase "UC-14\nReject ID Verification" as UC14
  }

  package "5. Listings" {
    usecase "UC-15\nView Listings" as UC15
    usecase "UC-16\nHide Listing" as UC16
    usecase "UC-17\nRestore Listing" as UC17
    usecase "UC-18\nApprove Listing Value" as UC18
    usecase "UC-19\nReject Listing Value" as UC19
  }

  package "6. Appeals" {
    usecase "UC-20\nView Appeals" as UC20
    usecase "UC-21\nUphold Appeal" as UC21
    usecase "UC-22\nOverturn Appeal" as UC22
    usecase "UC-23\nCancel Appeal Decision" as UC23
  }

  package "7. Users" {
    usecase "UC-24\nSearch Users" as UC24
    usecase "UC-25\nFilter Users" as UC25
    usecase "UC-26\nSuspend Account" as UC26
    usecase "UC-27\nUnsuspend Account" as UC27
  }

  package "8. Safe-Zone Hubs" {
    usecase "UC-28\nView Hubs" as UC28
    usecase "UC-29\nSearch Hub Location" as UC29
    usecase "UC-30\nPin Hub Location" as UC30
    usecase "UC-31\nCreate Hub" as UC31
    usecase "UC-32\nUpdate Hub" as UC32
    usecase "UC-33\nCancel Hub Edit" as UC33
  }

  package "9. Achievements" {
    usecase "UC-34\nView Achievements" as UC34
    usecase "UC-35\nUpload Badge Image" as UC35
    usecase "UC-36\nCreate Achievement" as UC36
    usecase "UC-37\nUpdate Achievement" as UC37
    usecase "UC-38\nDeactivate Achievement" as UC38
    usecase "UC-39\nReactivate Achievement" as UC39
    usecase "UC-40\nCancel Achievement Edit" as UC40
  }

  package "10. Trades" {
    usecase "UC-41\nReverse Trade Reward" as UC41
  }
}

