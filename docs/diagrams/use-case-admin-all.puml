@startuml use-case-admin-all
' ============================================================================
'  Baylo - Admin Console Use Case Diagram (ALL ROLES) - overview
'  Roles: Moderator, Admin, Super Admin.
'  ADMIN inherits MODERATOR; SUPER_ADMIN inherits ADMIN (actor generalization),
'  so the shared console is drawn ONCE and each role only points at what it
'  uniquely adds. Fine-grained actions live in the per-role files.
'  Source of truth: baylo-api/src/app/admin/** and /api/admin/** requireRole()
' ============================================================================

left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam nodesep 12
skinparam ranksep 55
skinparam ArrowThickness 1
skinparam usecase {
  BackgroundColor #F7F9F7
  BorderColor #1f6b43
  ArrowColor #536159
  FontColor #17201b
}
skinparam actor {
  BackgroundColor #1f6b43
  BorderColor #17201b
  FontColor #17201b
}
skinparam packageStyle rectangle
skinparam rectangle {
  BackgroundColor #FDFEFD
  BorderColor #1f6b43
  FontColor #17201b
}

title Baylo - Admin Console Use Cases (Moderator | Admin | Super Admin)

actor "Moderator" as MOD
actor "Admin" as ADM
actor "Super Admin" as SADM
MOD <|-- ADM
ADM <|-- SADM
rectangle "Baylo Admin Console" {

  package "Shared staff console (Moderator and above)" {
    usecase "Moderate reports\n(queue, inspect, action/dismiss)" as UC_MOD
    usecase "Manage listings\n(hide / restore)" as UC_LIST
    usecase "Review ID checks\n(approve / reject)" as UC_ID
    usecase "Handle value anomalies\n(approve / reject value)" as UC_VAL
    usecase "Decide appeals\n(uphold / overturn)" as UC_APPEAL
    usecase "Manage Safe-Zone hubs" as UC_HUB
    usecase "Reverse trade reward" as UC_REV
    usecase "Read audit log & dashboard" as UC_AUD
  }

  package "Admin only" {
    usecase "Search / inspect users" as UC_USERS
    usecase "Suspend / unsuspend account" as UC_SUSPEND
  }

  package "Super Admin only" {
    usecase "Change staff role" as UC_ROLE
  }
}

' ---- Shared (granted to Moderator, inherited upward) ----
MOD --> UC_MOD
MOD --> UC_LIST
MOD --> UC_ID
MOD --> UC_VAL
MOD --> UC_APPEAL
MOD --> UC_HUB
MOD --> UC_REV
MOD --> UC_AUD

' ---- Admin adds ----
ADM --> UC_USERS
ADM --> UC_SUSPEND

' ---- Super Admin adds ----
SADM --> UC_ROLE

legend bottom right
  Moderator     : the shared staff console
  Admin         : shared console + user accounts
  Super Admin   : everything + staff roles
  --
  Inheritance is UML actor generalization; every
  /api/admin route enforces the same rule with requireRole().
endlegend

@enduml
