  BIKES
  TOYS
  TOOLS
  MUSIC
  ART
  COLLECTIBLES
  PETS
  PLANTS
  FOOD
  SERVICES
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  AVAILABLE
  IN_TRADE
  TRADED
  OWNED
  REMOVED
  /**
   * The owner asked for a value more than one bracket above the suggestion,
   * and an admin has not yet said yes. A STATUS rather than a flag because
   * every discovery query in this codebase already filters on
   * `status: AVAILABLE`, so a listing in review is invisible to everyone but
   * its owner and the admin Anomalies tab without a single WHERE clause
   * changing. Approve moves it to AVAILABLE at the requested value. Reject
   * does NOT publish it: it moves to VALUE_REJECTED, the owner is told, and
   * they choose to relist at the suggestion, edit within the cap, or delete.
   */
  PENDING_REVIEW
  /**
   * The review said no. A SEPARATE STATUS from PENDING_REVIEW (18 Sep 2026)
   * so that "waiting for an admin" and "waiting for the owner" can be told
   * apart by every filter -- the Anomalies queue is the first, the owner's
   * shelf is the second, and a row that means both is a row nobody owns.
   * Same visibility as PENDING_REVIEW: nobody but the owner. Leaves it the
   * same three ways (list at the suggestion, edit within the cap, delete),
   * or by an overturned appeal, which publishes at the requested value.
   */
  VALUE_REJECTED
}

/**
 * WHY a value review was refused -- the part of the decision the owner is
 * shown. A closed list, like IdRejectionReason, so that the sentence the
 * owner reads is one this codebase wrote and not a moderator's aside; the
 * moderator's own note goes to the audit row only. Unlike the ID reasons
 * these are shown DELIBERATELY: a rejected value is something the owner is
 * being asked to fix, and they cannot fix what they are not told.
 */
enum ValueRejectionReason {
  OVERVALUED_FOR_CONDITION
  ABOVE_MARKET
  WRONG_CATEGORY
  PHOTOS_DO_NOT_SUPPORT_VALUE
  OTHER
}

enum TradeStatus {
  PENDING
  ACCEPTED
  CONFIRMING
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TRADE_REQUEST
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_COMPLETED
  TRADE_CANCELLED
  NEW_MESSAGE
  NEW_REVIEW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  // The outcome of a report the recipient filed. Google Play expects a reporter
  // to be told what happened, and /trust promises it in so many words.
  REPORT_RESOLVED
  // The outcome of an ID submission. TWO TYPES AND NOT ONE: the approval is
  // good news that unlocks posting, the rejection carries a specific fix and a
  // remaining-attempts count, and a client that wants to style them differently
  // should not have to read the message text to tell them apart.
  ID_VERIFICATION_APPROVED
  ID_VERIFICATION_REJECTED
  /**
   * An offer of the recipient's own aged out unanswered. Sent to the SENDER
   * only — the receiver is the one who did not reply, and telling them so is a
   * reproach rather than information. It carries the released Leaves in its
   * message because that is the part the sender can act on.
   */
  OFFER_EXPIRED
  /**
   * The other party proposed, or agreed, a place and time to meet.
   *
   * TWO NEW VALUES RATHER THAN REUSING TRADE_ACCEPTED, because this column is
   * the EVENT and a proposal is not an acceptance — the model's own note draws
   * that line. They also need different words and different urgency: a proposal
   * is a question waiting on the recipient, an agreement is a settled fact.
   *
   * Both carry entityType "meetup", which is a NEW routing token and not
   * "trade": a trade notification opens the confirmation codes, and sending
   * somebody there to answer "can you do Saturday?" would put a 15-minute code
   * on screen days before the meeting.
   */
  MEETUP_PROPOSED
  MEETUP_AGREED
  /**
   * The outcome of a value review on the recipient's own listing. Two types
   * for the same reason ID verification has two: the approval says "it's
   * live", the rejection carries a choice the owner has to make.
   */
  LISTING_VALUE_APPROVED
  LISTING_VALUE_REJECTED
  /**
   * A moderator hid the recipient's listing. Until 18 Sep 2026 a takedown
   * told the owner nothing: the tile stayed on their shelf and opening it
   * 404ed. Carries no reason and no actor -- the appeal screen says what a
   * takedown is and how to answer it.
   */
  LISTING_HIDDEN
  /** The outcome of the recipient's appeal. Two types, same reason as above. */
  LISTING_APPEAL_UPHELD
  LISTING_APPEAL_OVERTURNED
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

