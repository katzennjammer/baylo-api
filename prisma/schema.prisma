generator client {
  provider = "prisma-client"
  // schema v2 generates into its OWN folder (see tsconfig "paths"), so this
  // branch and the pre-v2 branches can never pick up each other's client.
  output   = "../src/generated/prisma-v2"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?

  // Account verification. This flag — never "password is null" — is what
  // "verified" means. Google sign-in (web callback and native token exchange)
  // sets it, and so does the emailed verification link. Flipping it false ->
  // true is what triggers the VERIFY_ACCOUNT award and the one-time signup
  // grant; see markVerified().
  //
  // NOT the government-ID check. That is IdVerification below, it is derived
  // rather than flagged, and it gates posting and DPA proposals rather than the
  // signup grant. The two are separate on purpose and must not be folded
  // together.
  isVerified Boolean @default(false)

  // One-time signup grant (SIGNUP_GRANT_LEAVES), claimed at verification, never
  // at registration — an ungated grant lets an attacker mint Leaves by mass-
  // creating accounts. Set true in the SAME statement that credits the Leaves,
  // so two concurrent verifications cannot both pay out.
  signupGrantClaimed Boolean @default(false)

  // Date of birth, and the 18+ gate that reads it.
  //
  // A DATE column, not a DateTime: this is a calendar fact and it has no time
  // and no zone. Storing an instant means a user in UTC+8 born exactly eighteen
  // years ago is written as the day before, and for exactly that person on
  // exactly that day the column decides whether they may hold an account. See
  // src/lib/age.ts, which is the only place the arithmetic is done.
  //
  // NULLABLE, and it stays nullable. Every account created before this column
  // existed has no value here, and a required column would mean either
  // inventing dates of birth for real users or locking them out. New accounts
  // are refused without one — /api/auth/register requires it, and the Google
  // exchange reports `needsDateOfBirth` so the native client can ask for it —
  // so the null set only ever shrinks.
  dateOfBirth DateTime? @db.Date

  avatar      String?
  bio         String?  @db.Text
  location    String?
  rating      Float    @default(0)
  totalTrades Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Account deletion (DELETE /api/user). The row is ANONYMISED here, never
  // removed, and that is a ledger decision rather than a soft-delete habit:
  // LeafTransaction.userId is a foreign key with onDelete: Cascade, so dropping
  // the row would silently delete that user's ledger history and break
  // SUM(User.leaves) == SUM(LeafTransaction.amount) — the one invariant the
  // whole Leaf economy is checked against. Retiring the account keeps both
  // sides of that equation intact while the personal data is scrubbed.
  //
  // Non-null means gone: resolveSession() refuses these accounts, so an access
  // token issued before deletion stops working immediately.
  deletedAt DateTime?

  // Premium subscription. Null or in the past means not subscribed; there is no
  // boolean beside it, because a boolean would have to be flipped back by a job
  // when the term ends and this column simply stops being true.
  //
  // NOTHING WRITES THIS YET. Play Billing is the only lawful way to sell a
  // digital subscription inside the Android app and there is no Play Console
  // account to test it against, so the column is set by hand
  // (scripts/set-premium.ps1) and read by ONE place: isPremium() in
  // @/lib/premium. What it gates is ACQUIRING an item whose value bracket is
  // PREMIUM_MIN_BRACKET or above -- proposing for one, or accepting an offer
  // of one -- see @/lib/brackets. It never hides a listing and never gates
  // giving one away.
  //
  // BETA (provisional, 30 Sep 2026): Premium is a one-time lifetime purchase
  // for now, stored as the sentinel PREMIUM_LIFETIME_UNTIL (9999-12-31) in
  // @/lib/premium -- a real future date, so isPremium() is unchanged.
  premiumUntil DateTime?

  // VIP subscription (23 Sep 2026). Same shape and same caveats as
  // premiumUntil -- a date, not a boolean, set by hand today via
  // scripts/set-premium.ps1 and read by ONE place, isVip() in @/lib/premium.
  //
  // VIP is a SUPERSET of Premium, not a sibling of it: it gates acquiring an
  // item at VIP_MIN_BRACKET or above (see @/lib/brackets), and it ALSO passes
  // everything premiumUntil alone would -- a VIP subscriber never needs both
  // columns set. enforcePremiumForListing() checks vip before premium for
  // exactly that reason.
  vipUntil DateTime?

  items                  Item[]
  /// Every deal this account proposed, or was proposed to -- the offer phase
  /// and the trade phase are one Trade row (schema v2). See Trade.
  sentTrades             Trade[]           @relation("TradeSender")
  receivedTrades         Trade[]           @relation("TradeReceiver")
  sentMessages           Message[]         @relation("SentMessages")
  receivedMessages       Message[]         @relation("ReceivedMessages")
  notifications          Notification[]    @relation("NotificationRecipient")
  triggeredNotifications Notification[]    @relation("NotificationActor")
  reviewsGiven           Review[]          @relation("ReviewsGiven")
  reviewsReceived        Review[]          @relation("ReviewsReceived")
  following              Follow[]          @relation("Follower")
  followers              Follow[]          @relation("Followee")
  likes                  Like[]            @relation("UserPostLikes")
  comments               Comment[]         @relation("UserPostComments")
  leaves                 Int               @default(0)
  lifetimeLeaves         Int               @default(0)
  leafTransactions       LeafTransaction[]
  swapCodes              SwapCode[]
  /// Refresh, password-reset and email-verification tokens. See AuthToken.
  authTokens             AuthToken[]
  /// Daily quests and earned badges. See UserProgress.
  progress               UserProgress[]

  // ── Moderation ─────────────────────────────────────────────────────────────
  //
  // The first privileged concept in this codebase. Every other authorisation
  // decision here is ownership-based -- you may edit an item because it is your
  // item -- and that shape cannot express "may act on someone else's content",
  // which is the whole job of a moderator.
  //
  // NO API ROUTE WRITES THIS COLUMN. Not an admin-only one, not a
  // super-admin-only one, none. An endpoint that can grant ADMIN is a
  // privilege-escalation target whose entire value is saving somebody a SQL
  // prompt once a year, and the escalation is total: an ADMIN can suspend every
  // account including the ones that would notice. Promotion is:
  //
  //   UPDATE `User` SET `role` = 'ADMIN' WHERE `email` = '...';
  //
  // Enforced by absence, and by scripts/verify-moderation.ts, which greps the
  // route tree for any handler that reads `role` out of a request body.
  role Role @default(USER)

  // Account suspension, written only by POST /api/admin/users/[id] with
  // action "suspend" / "unsuspend".
  //
  // suspendedAt     non-null means suspended right now.
  // suspendedUntil  when it lifts. NULL WITH suspendedAt SET MEANS INDEFINITE --
  //                 not "already lifted". suspensionState() in @/lib/moderation
  //                 is the only correct reading of the pair; do not test either
  //                 column alone.
  //
  // Both are CLEARED on unsuspend rather than kept as history. That is the
  // opposite of DeferredContract.defaultedAt, and deliberately so: a default is
  // a fact about the debtor that the tier system keeps charging against, while a
  // lifted suspension is a moderation decision whose record belongs in
  // AdminAction, next to who lifted it and why. A suspension history smeared
  // across the User row would be a second, worse audit log.
  suspendedAt    DateTime?
  suspendedUntil DateTime?

  /// Reports this person filed and listing appeals they opened (filedBy), and
  /// the cases they decided as staff (decidedBy). See ModerationCase.
  casesFiled     ModerationCase[] @relation("ModerationCaseFiler")
  casesDecided   ModerationCase[] @relation("ModerationCaseDecider")
  blocksMade     Block[]          @relation("Blocker")
  blocksReceived Block[]          @relation("Blocked")
  adminActions   AdminAction[]    @relation("AdminActor")

  /// Stories this person posted, and the stories they have seen. See Story.
  stories    Story[]     @relation("StoryAuthor")
  storyViews StoryView[] @relation("StoryViewer")

  // -- Organisation / MSME accounts -------------------------------------------
  //
  // TRUE ON A SYNTHETIC ROW THAT IS NOT A PERSON. An Organization is backed by
  // a User row so that every FK already pointing at User -- Item.userId,
  // Follow.followeeId, Message.senderId/receiverId, Offer, TradeRequest,
  // LeafTransaction.userId -- keeps working without a second, org-shaped copy
  // of each. The cost of that choice is that a row in this table is no longer
  // necessarily a human being, and this column is what says so.
  //
  // A STORED BOOLEAN, WHICH IS THE OPPOSITE OF WHAT `totalTrades` AND THE
  // ABSENT `idVerified` ARE NOTED ABOVE FOR. The rule those notes set --
  // derive it, never denormalise it -- is right when the derived fact is read
  // on a page, and wrong here, for two reasons:
  //
  //   WHEN.  The row has to be recognisable as non-human in the same statement
  //          that creates it. `organization: { is: null }` is only true once
  //          the Organization row exists, and between the two writes a
  //          synthetic row reads as a person to every query in this codebase.
  //          Both writes are in one transaction, so the window is short -- but
  //          "short" is not a property a trust-tier aggregate should depend on.
  //   WHERE. Trust tiers, the leaf-rank ladder and the reputation gate are
  //          aggregate queries over User. A relation filter makes each of them
  //          a join; a column makes each of them a predicate.
  //
  // It cannot drift, because it has exactly one writer -- createOrganization()
  // in @/lib/organizations, which sets it in the same transaction as the
  // Organization row -- and nothing ever updates it. scripts/verify-orgs.ts
  // asserts the biconditional: isOrgAccount is true for exactly the rows an
  // Organization points at.
  //
  // WHAT IT EXCLUDES: the trade-count trust ladder and the leaf-rank badge. An
  // organisation is not RISING; it is verified or it is not. See
  // notAnOrgWhere() in @/lib/organizations, which every reputation aggregate
  // spreads in.
  isOrgAccount Boolean @default(false)

  /// The organisation this row IS, when isOrgAccount. Null on every human row.
  organization Organization? @relation("OrganizationAccount")

  /// The organisations this HUMAN owns. Empty on a synthetic org row -- an org
  /// does not own itself. Staff memberships were removed in schema v2; the
  /// owner is the only person who may act as an organisation.
  ownedOrganizations Organization[] @relation("OrganizationOwner")

  /// Business documents this user decided, as an admin. Mirrors
  /// idVerificationsReviewed, and SetNull for the same reason: the decision
  /// outlives the staff account that made it.
  organizationsReviewed Organization[] @relation("OrganizationReviewer")

  // -- Government ID verification ---------------------------------------------
  //
  // NOT `isVerified`, AND THE TWO MUST NOT BE CONFLATED. `isVerified` above
  // means "this person controls this mailbox"; it costs nothing to obtain and
  // it gates nothing except the signup grant. This is the second, much heavier
  // one: a photographed government ID, reviewed by a human, gating the two acts
  // that can cost somebody else real property -- posting an item and proposing
  // a deferred agreement.
  //
  // THERE IS NO `idVerified` BOOLEAN ON THIS ROW, deliberately. The answer is
  // derived from the rows below (an APPROVED IdVerification, or the
  // grandfather stamp), for the reason the note on totalTrades records: a
  // denormalised copy of a fact is a fact that can drift out of step with the
  // rows that produced it, and this one decides whether a listing may exist.
  // See isIdVerified() in @/lib/id-verification, which is the only reading.
  idVerifications         IdVerification[] @relation("IdVerificationSubject")
  idVerificationsReviewed IdVerification[] @relation("IdVerificationReviewer")

  // The grandfather stamp: non-null means this account was let past the ID
  // gate WITHOUT a review, at the moment the gate was introduced.
  //
  // A TIMESTAMP AND NOT A BOOLEAN, and a column rather than a synthetic
  // IdVerification row. A synthetic row would need an idType and an
  // idNumberHash that do not exist, would have to be excluded from the
  // uniqueness index by hand, and would read in the admin queue as a decision
  // somebody made. This says exactly what happened: nobody looked at an ID for
  // this account, and here is when we decided not to. Cleared by an ADMIN if a
  // grandfathered account should be made to submit after all.
  idVerifiedGrandfatheredAt DateTime?

  // Every reputation aggregate filters on this. Cheap, and the reason the flag
  // is a column rather than a join -- see the note above.
  @@index([isOrgAccount])
  // Soft-delete and suspension sweeps. Raw CREATE INDEX in the old chain;
  // declared here so they survive the squash.
  @@index([deletedAt])
  @@index([suspendedAt])
}

model Follow {
  id        String       @id @default(cuid())
  status    FollowStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([followeeId])
}

/// Which kind of credential an AuthToken row is.
enum AuthTokenType {
  /// Native-client session refresh. Single use, rotated, grouped by familyId.
  REFRESH
  /// "Forgot password" link. Single use, short-lived.
  PASSWORD_RESET
  /// "Verify your email" link. Single use, 24 hours, one live per user.
  EMAIL_VERIFICATION
}

/// Every bearer secret this API hands out, ONE TABLE, HASHES ONLY (schema v2).
///
/// Was three tables: RefreshToken, PasswordResetToken, EmailVerificationToken.
/// They shared a shape -- a secret, an owner, an expiry -- and differed in two
/// ways this model now states as columns rather than as table boundaries:
///
///   HASHED, ALL OF THEM. `tokenHash` is the SHA-256 hex of the secret and the
///   secret itself is never stored. PasswordResetToken used to keep the token in
///   the clear and key it on an email; the v2 data migration hashed the two
///   rows that existed and resolved the email to `userId`, so an email change
///   can no longer leave a reset link that resets the new address.
///
///   REFRESH-ONLY COLUMNS. `familyId`, `usedAt` and `revokedAt` mean something
///   only for a refresh token (rotation, replay detection, family revocation;
///   see @/lib/auth-tokens). They are NULL on the other two types, and a CHECK
///   constraint in 20261003000000_schema_v2_core says so:
///     type = 'REFRESH'  <=>  familyId IS NOT NULL
///     type <> 'REFRESH'  =>  usedAt IS NULL AND revokedAt IS NULL
///
/// The other two are single-use by DELETION (the row is removed on redemption),
/// exactly as before. `tokenHash` is unique across all three types: a 256-bit
/// random secret colliding across types is not a case worth a composite key.
model AuthToken {
  id        String        @id @default(cuid())
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  /// REFRESH only. Every token minted from the same original login shares it;
  /// a replay revokes the whole family.
  familyId  String?
  /// REFRESH only. Stamped the first time the token is redeemed.
  usedAt    DateTime?
  /// REFRESH only.
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime      @default(now())

  /// "this user's tokens of this kind" -- purge-on-issue for verification and
  /// reset, logout-everywhere for refresh.
  @@index([userId, type])
  // familyId is not decoration: revoking a family on replay looks up by it.
  @@index([familyId])
}

model Item {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  category    Category
  condition   Condition
  // The FINAL value: what the owner is asking, after any override they made.
  // This is the number every other surface reads. The owner may set it lower
  // than the suggestion freely, or higher up to ONE BRACKET above the
  // suggestion's bracket; anything above that is stored here as REQUESTED and
  // the listing sits in PENDING_REVIEW until an admin approves it (see
  // decideItemValue() in @/lib/valuation-server and the ItemStatus note).
  valueLeaves Int?

  /// The value bracket of `valueLeaves`, 1..10. NULL exactly when valueLeaves is.
  ///
  /// A STORED GENERATED COLUMN, so it cannot drift and nothing writes it:
  ///   GENERATED ALWAYS AS (CASE WHEN "valueLeaves" IS NULL THEN NULL
  ///     WHEN "valueLeaves" <= 100 THEN 1 ... WHEN <= 12000 THEN 9 ELSE 10 END) STORED
  /// Prisma cannot declare a generated column; it lives in
  /// 20261003000000_schema_v2_core and a `migrate diff` never mentions it. Any
  /// write that names `bracket` is refused by Postgres, which is the point.
  ///
  /// THE CEILINGS ARE COPY THREE of BRACKET_CEILINGS in @/lib/brackets (and
  /// baylo-mobile/src/lib/brackets.ts). Change the table there, and this column
  /// needs a migration that re-creates it with the new CASE -- the generation
  /// expression is fixed at DDL time. scripts/schema-v2/verify-v2.ts compares
  /// it with bracketOf() on every row.
  ///
  /// (The MariaDB 10.4 stored-generated-column hang noted on ModerationCase
  /// .openKey does not apply: this is Postgres, and the column is in no unique
  /// index.)
  bracket Int? @default(dbgenerated())

  // TRUE when the owner typed their own value rather than taking the
  // suggestion. Stored, not derived from valueLeaves != suggestedLeaves: an
  // owner can type the suggested number back in, and a category re-valuation
  // can move suggestedLeaves under a value the owner never touched. The admin
  // Listings page shows both numbers and this flag side by side.
  valueSetByUser Boolean @default(false)

  // The valuation model's own number, before the owner touched it. Stored
  // alongside the final value rather than instead of it so the divergence
  // between what the model said and what people listed at is MEASURABLE:
  //   SELECT AVG((valueLeaves - suggestedLeaves) / suggestedLeaves) FROM Item
  //   WHERE suggestedLeaves IS NOT NULL;
  // NULL means the listing predates the valuation system (see the 2026-08-25
  // migration) — it does not mean "no suggestion was made".
  suggestedLeaves Int?

  // Which path produced suggestedLeaves: "comparables" or "category_band",
  // exactly those strings. A plain VARCHAR and not an enum on purpose: the same
  // two literals go out on the wire, and a wire value generated from a DB enum
  // name is one that changes the day someone renames the enum. The writable set
  // is closed in code by VALUATION_SOURCES in @/lib/valuation.
  //
  // This column exists to answer one question with a query instead of a guess:
  // how many listings were valued from real Baylo trade history rather than the
  // fallback band table.
  valuationSource String? @db.VarChar(32)

  // Re-valuations already spent on this listing. Capped at MAX_REVALUATIONS.
  // The model is deterministic, so re-running it on unchanged inputs returns
  // the identical number; the only way a repeat request moves the suggestion is
  // if the category or condition was edited. One correction is allowed, then
  // the listing is done shopping for a friendlier number.
  revaluationCount Int @default(0)

  status ItemStatus @default(AVAILABLE)

  // Free text only: what the owner wants in return. This column used to double
  // as a JSON envelope carrying the pickup coordinates, which is how a home
  // address ended up being served to unauthenticated callers — a field named
  // "wanted items" is not somewhere anyone thinks to look for location data.
  // Pickup now lives in the three explicit columns below and is filtered by
  // resolvePickup() in @/lib/item-visibility on every read path.
  wantedItems String? @db.Text

  // Exact pickup point. NEVER serialise these straight onto a response: full
  // precision plus pickupAddress identifies a seller's home. Only the owner and
  // an accepted trade counterparty may see them; everyone else gets the
  // 2-decimal-place (~1 km) rounding that resolvePickup() applies.
  //
  // CHECK Item_pickup_shape_check (20261004000000_schema_v2_audit_fixes): both
  // coordinates or neither, and an address only with a pin. A pin with no
  // address is legal.
  pickupLat     Float?
  pickupLng     Float?
  pickupAddress String? @db.Text

  // Moderator takedown. NULL means "not hidden by us"; non-null is the moment a
  // moderator removed it, and the who/why lives in the AdminAction row written
  // in the same transaction.
  //
  // A SEPARATE COLUMN AND NOT `status = REMOVED`, for one concrete reason: the
  // owner can already move their own item in and out of REMOVED/OWNED/AVAILABLE
  // -- POST /api/items/[id]/relist does exactly that -- so a takedown expressed
  // as a status would be undoable by the person it was aimed at. Every read path
  // filters on `moderationHiddenAt: null` in the WHERE clause, and relist
  // refuses while it is set.
  moderationHiddenAt DateTime?

  // Set when a value review is refused (status VALUE_REJECTED); cleared when
  // the listing leaves that status. The code, never the moderator's note --
  // the note lives in the AdminAction row. Nullable so main can read every
  // row before the feature lands (the schema-first rule, see SETUP.md).
  valueRejectionReason ValueRejectionReason?

  /// Value-rejection and takedown appeals against this listing. See ModerationCase.
  appeals ModerationCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Deals that offered this item, and deals that asked for it. See Trade.
  tradesOffered   Trade[]   @relation("TradeOfferedItem")
  tradesRequested Trade[]   @relation("TradeRequestedItem")
  likes           Like[]    @relation("ItemPostLikes")
  comments        Comment[] @relation("ItemPostComments")

  /// Public meetup points this listing is offered at. ZERO IS NORMAL and means
  /// delivery-only or arrange-it-in-chat -- it is not an incomplete listing.
  /// Capped at MAX_ITEM_HUBS by the write paths; see @/lib/safe-zones.
  safeZones ItemSafeZone[]

  /// The photos, in order, each with its dHash. Was the `images` JSON column
  /// plus ItemImageHash (schema v2). See ItemImage.
  images ItemImage[]

  /// The categories the owner will take in return. See ItemWantedCategory.
  wantedCategories ItemWantedCategory[]
  /// 24-hour stories that share this listing. See Story.
  stories          Story[]

  // -- Perishables, and what the owner wants back -----------------------------
  //
  // ALL OPTIONAL, AND NULL ON EVERY ROW THAT PREDATES THEM.
  // A listing made before this block reads exactly as it did: isPerishable
  // false, no quantity, no window, and no ItemWantedCategory rows. Nothing
  // in the matcher, the feed or the expiry sweep treats that as a listing with
  // something missing -- see the note on ItemWantedCategory.

  /// Food, flowers, produce -- something with a shelf life. The flag that turns
  /// the three columns below from noise into meaning, and the one the expiry
  /// sweep selects on.
  ///
  /// IT DOES NOT BUY A HIGHER VALUE. A perishable whose requested value lands
  /// more than one bracket above the model's suggestion is CLAMPED to the cap
  /// and published, rather than waiting in PENDING_REVIEW -- the point is that
  /// nothing perishable sits in a queue while it rots. It is emphatically not
  /// a way around decideItemValue(): the cap is the same cap, and a value above
  /// it is refused here exactly as it is anywhere else. See
  /// decidePerishableValue() in @/lib/perishable.
  isPerishable Boolean @default(false)

  /// How much of it. A Float because "1.5 kg" and "0.5 L" are real listings and
  /// an Int would round them into lies. Null on a standard item, and null is
  /// also fine on a perishable -- "a basket of calamansi" has no number.
  quantity Float?

  /// The unit `quantity` is in. Null exactly when quantity is null; the write
  /// paths refuse one without the other, because a bare "2" is not a quantity.
  quantityUnit QuantityUnit?

  /// The window, in hours, from createdAt. 6 or 24 in the wizard; stored as an
  /// Int rather than an enum so the number can be widened without a migration
  /// and so the arithmetic below is arithmetic.
  ///
  /// COUNTED FROM createdAt AND NOT FROM NOW, which is what makes the sweep
  /// replayable: a job that did not run for two days expires exactly the
  /// listings that were already past their window, and running it twice
  /// changes nothing the first run did not.
  ///
  /// Set exactly when isPerishable is: CHECK Item_perishable_window_check
  /// (20261004000000_schema_v2_audit_fixes).
  tradeWithinHours Int?

  // Featured boosts were REMOVED in schema v2 (isFeatured, featuredUntil,
  // featuredAt). The FEATURE_BOOST ledger rows they wrote are kept: they are
  // Leaves that left the system, and the ledger never forgets a movement.
  // The wanted-categories list moved to ItemWantedCategory, which replaces the
  // GIN index this table used to carry for the matcher.

  /// The perishable sweep: unexpired perishables, oldest first. Partial on the
  /// flag would be tighter, which Prisma cannot declare -- the composite is
  /// what it can express, and it is enough.
  @@index([isPerishable, status, createdAt])
  /// Bracket filters on the AVAILABLE feed (search assistant, marketplace).
  @@index([status, bracket])
  // Both created by raw CREATE INDEX in the pre-baseline chain and never
  // declared here. Declaring them keeps the squashed baseline faithful.
  // "hidden takedowns, and the AVAILABLE feed that must exclude them".
  @@index([status, moderationHiddenAt])
  // The comparables lookup: same source, same category.
  @@index([valuationSource, category])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
}

/// One photo of one listing, in order (schema v2).
///
/// WAS TWO THINGS: the `Item.images` column (a JSON array of URLs in a TEXT
/// column -- the schema's one real 1NF violation) and ItemImageHash (one dHash
/// per photo, keyed by the photo's index INTO that JSON array). The pair had
/// to be kept in step by hand; here the URL and its hash are the same row, so
/// they cannot disagree about which photo is which.
///
/// `position` is 0-based and dense: 0 is the lead photo every card draws.
/// `hash` is NULL for photos that were never hashed (listings older than the
/// duplicate check, or a hash that failed); the duplicate scan reads only the
/// non-null ones, which is exactly the pool ItemImageHash held.
model ItemImage {
  itemId   String
  position Int
  url      String  @db.Text
  hash     String? @db.VarChar(64)
  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// The PK's leading column is the only lookup by item anyone needs, and the
  /// pair enforces one photo per slot. The duplicate scan reads the whole
  /// table and compares in JS -- Hamming distance is not something an index can
  /// answer -- so there is deliberately no index on `hash`.
  @@id([itemId, position])
}

/// One category a listing's owner will take in return. THE MATCHER'S INPUT,
/// and deliberately NOT perishable-only (schema v2; was the enum array
/// Item.lookingForCategories).
///
/// NO ROWS IS THE STEADY STATE, NOT A MISSING VALUE. Every listing whose owner
/// skipped the question has none, and the matcher skips a listing with none
/// rather than treating it as "wants everything"; see matchesFor() in
/// @/lib/category-match.
///
/// The composite PK makes a repeated category impossible, which the array
/// never enforced. The `category` index is what the matcher's
/// "who wants FOOD?" lookup reads; it replaces the GIN index on the array.
model ItemWantedCategory {
  itemId   String
  category Category
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, category])
  @@index([category])
}

/// ONE DEAL, FROM PROPOSAL TO HANDOFF, IN ONE ROW (schema v2).
///
/// Was two tables. An Offer was the proposal ("my item for your listing"); on
/// accept, the accept route created a SEPARATE TradeRequest and copied half the
/// offer's columns onto it, with nothing linking the two rows -- the old
/// correlation (sender + listing + ACCEPTED + a substring match on a JSON list)
/// was ambiguous for 21 of 36 trades and settled only by "closest timestamp".
/// A deal is now one row that moves through two phases:
///
///   OFFER PHASE  `offerStatus` -- PENDING, then DECLINED / WITHDRAWN / EXPIRED,
///                or ACCEPTED. NULL on a deal that never had an offer phase (a
///                legacy direct trade request from the web, or a seeded trade).
///   TRADE PHASE  `status` -- ACCEPTED, CONFIRMING, COMPLETED, CANCELLED, or
///                PENDING/REJECTED for a legacy direct request. NULL until the
///                deal is accepted into a trade; `tradeCreatedAt` is set in the
///                same statement. An offer that was accepted and still has
///                `status` NULL is a legacy Leaves-only offer (June 2026) that
///                never became a trade -- 11 such rows were migrated.
///
/// CHECK constraints in 20261003000002_schema_v2_trade hold the shape:
///   offerStatus IS NOT NULL OR status IS NOT NULL
///   (status IS NULL) = (tradeCreatedAt IS NULL)
///   status IS NULL OR offeredItemId IS NOT NULL
///
/// IDS. A migrated deal that had a TradeRequest keeps the TradeRequest's id, so
/// every Message, Review, SwapCode, AdminAction, Notification and ledger row
/// that pointed at the trade still does. The Offer's id survives in
/// `legacyOfferId` (unique), because chat message payloads written before
/// v2 embed it -- resolve an id from a client by `id` first, then by
/// `legacyOfferId`. A deal that was only ever an offer keeps the Offer's id as
/// its `id` AND in `legacyOfferId`.
model Trade {
  id            String  @id @default(cuid())
  legacyOfferId String? @unique

  senderId   String
  sender     User   @relation("TradeSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("TradeReceiver", fields: [receiverId], references: [id])

  /// The listing the sender asked for (Offer.postId / TradeRequest.requestedItemId).
  /// Restrict, which is NEW: Offer.post used to Cascade, so hard-deleting a
  /// listing silently deleted its offers -- and with them the only row that
  /// explained a BRIDGE_FEE_HOLD on the ledger. Listings are soft-deleted
  /// (status REMOVED); a hard delete of one with deal history now fails loudly.
  requestedItemId String
  requestedItem   Item   @relation("TradeRequestedItem", fields: [requestedItemId], references: [id], onDelete: Restrict)

  /// The item the sender put up, as a real foreign key. Was a client-written
  /// JSON list (`Offer.offeredItems`) matched with a substring LIKE. NULL only
  /// on legacy Leaves-only offers that named no item (15 migrated rows) -- the
  /// CHECK above makes it required once a deal is a trade.
  offeredItemId String?
  offeredItem   Item?   @relation("TradeOfferedItem", fields: [offeredItemId], references: [id], onDelete: Restrict)

  /// The offer phase. NULL = no offer phase (see the model note).
  offerStatus OfferStatus?
  /// The trade phase. NULL = not (yet) a trade (see the model note).
  status      TradeStatus?

  message String? @db.Text

  /// When the deal was first proposed: the Offer's createdAt, or the
  /// TradeRequest's for a deal with no offer phase. The offer-expiry window is
  /// measured from here.
  createdAt      DateTime  @default(now())
  /// When the deal became a trade -- what TradeRequest.createdAt used to mean.
  /// Equal to createdAt on a deal with no offer phase.
  tradeCreatedAt DateTime?
  updatedAt      DateTime  @updatedAt
  /// The moment settlement committed -- written once, inside the completion
  /// transaction in confirm/submit, and never touched again. `updatedAt` is
  /// NOT this: any later write to the row (a meetup field, say) moves
  /// it, which is how an old trade could count toward TODAY's trade quest.
  /// Trades completed before 25 Sep 2026, when the column was added, were
  /// BACKFILLED by 20261004000001_schema_v2_trade_completed_backfill: the
  /// earliest paid settlement row in the ledger, else the row's updatedAt.
  /// So it is non-null on every COMPLETED trade, but approximate on those.
  completedAt    DateTime?

  // hiddenBySender / hiddenByReceiver were DROPPED in schema v2
  // (20261004000002_schema_v2_drop_trade_hidden): only the web dashboard ever
  // set them and no row on live had either one true.

  /// WHICH Safe-Zone hub the parties say they met at. NULL means they did not
  /// claim one, and it is what the SAFEZONE_MEETUP reward keys off -- the
  /// reward condition is `safeZoneHubId IS NOT NULL`, not a separate flag.
  ///
  /// THIS IS PRE-COMMITTED SELF-ATTESTATION. IT IS NOT VERIFICATION, and the
  /// distinction is worth stating plainly rather than letting a foreign key
  /// imply proof:
  ///
  ///   What it does NOT establish: that these two people were ever at this
  ///   place. Nothing here observes the world. A participant who wants the 10
  ///   Leaves without going to Parkmall types the same request as one who went.
  ///
  ///   What it DOES establish: the claim was pre-committed and is mutual. The
  ///   hub must be one that BOTH traded listings were already publicly offered
  ///   at, which means both owners independently named it before this trade
  ///   existed, and the counterparty could see it at offer time. A lie now has
  ///   to be arranged in advance, by two people, in public, rather than ticked
  ///   at the end by one of them.
  ///
  ///   What replaced what: this used to be `safeZoneMeetup Boolean`, set by
  ///   either party sending `safeZone: true` at confirmation. That was
  ///   unfalsifiable and uncorrelated with anything -- an unauditable boolean
  ///   attached to a currency award.
  ///
  /// GPS proximity was considered and deliberately rejected. A client-reported
  /// coordinate is spoofable from a developer-options toggle, so without device
  /// attestation it is a more elaborate checkbox; and every seeded hub landmark
  /// is indoors or under a roof, where GPS routinely drifts 50-200 m, so an
  /// honest-user-safe radius in a dense commercial strip would cover several
  /// other hubs anyway. The honest position is the one written above.
  safeZoneHubId String?
  safeZoneHub   SafeZoneHub? @relation("MeetupClaim", fields: [safeZoneHubId], references: [id], onDelete: Restrict)

  /// ── THE MEETUP PLAN ───────────────────────────────────────────────────────
  ///
  /// Where and when the parties have ARRANGED to meet. This is a different fact
  /// from `safeZoneHubId` directly above it, and the two must never be merged:
  ///
  ///   `safeZoneHubId`  is the CLAIM. "We met here", asserted afterwards, at
  ///                    confirm/submit. It is what the SAFEZONE_MEETUP reward
  ///                    keys off -- the condition is literally
  ///                    `safeZoneHubId IS NOT NULL`.
  ///   `meetupHubId`    is the PLAN. "Let us meet here", asserted beforehand,
  ///                    by one party and agreed by the other. It awards nothing.
  ///
  /// WRITING A PLAN INTO THE CLAIM WOULD MINT 10 LEAVES FOR A MEETING THAT HAS
  /// NOT HAPPENED, and would do it at the moment somebody merely SUGGESTED a
  /// place. A plan is not evidence; only the pair of typed codes is. The plan
  /// does become the DEFAULT for the claim at confirmation -- the parties should
  /// not be asked twice -- but it is copied across by the confirm route, after
  /// the codes match, and never read as the claim itself.
  ///
  /// THE FOUR COLUMNS MOVE TOGETHER. Three states, and nothing else is legal:
  ///
  ///   no plan    all four NULL
  ///   proposed   hub + at + proposedBySender set, agreedAt NULL
  ///   agreed     all four set
  ///
  /// The invariant is enforced in the meetup routes rather than by a CHECK
  /// constraint, which MariaDB 10.4 will parse and Prisma will not model. Every
  /// write of these columns goes through one of the two routes and each writes
  /// the whole group.
  meetupHubId String?
  meetupHub   SafeZoneHub? @relation("MeetupPlan", fields: [meetupHubId], references: [id], onDelete: Restrict)

  /// When they have arranged to meet. A real timestamp rather than free text:
  /// two people agreeing to "sat afternoon ha" have not agreed on anything a
  /// reminder, a sort, or the other person's calendar can act on.
  meetupAt DateTime?

  /// "the bench outside, I'll have the blue bag". The detail a hub id and a
  /// timestamp cannot carry. Optional, short, and never load-bearing.
  meetupNote String? @db.VarChar(200)

  /// WHICH SIDE proposed the standing plan -- deliberately a side and not a
  /// userId. A `meetupProposedById` FK can point at somebody who is not in this
  /// trade, and then "you cannot accept your own proposal" is guarding against
  /// a state the column let us write in the first place. A boolean against
  /// `senderId`/`receiverId` cannot be wrong, and rendering "Renz suggested"
  /// only ever needed to know which of the two names to use.
  meetupProposedBySender Boolean?

  /// Set when the OTHER side agrees. NULL with a hub set means one proposal is
  /// standing and unanswered. A counter-proposal overwrites the plan and clears
  /// this, which is why there is no separate decline: countering IS declining,
  /// and it leaves something on the table instead of a hole.
  meetupAgreedAt DateTime?

  // Leaves moving from sender to receiver as part of this trade. NULL means
  // none — the same thing the `?? 0` at each old recovery site meant.
  //
  // This is recorded ON the trade rather than recovered from the Offer that
  // produced it. The old correlation (senderId + postId + status ACCEPTED) is
  // not unique: five trades match more than one accepted offer, one matches
  // eight, and one sender/post pair holds two different amounts (100 and 200).
  // Settlement resolved that with findFirst() and no orderBy, so the amount it
  // debited was whichever row the optimiser returned. Settlement is the one
  // code path that moves currency; it does not get to guess.
  offeredLeaves Int?

  /**
   * The bridging fee this trade carries, copied from the Offer at accept for
   * exactly the reason `offeredLeaves` is: settlement and cancellation read
   * the trade and never re-find the offer. NULL means same-bracket, no fee.
   * The Leaves are already out of the payer's balance by the time a trade
   * exists; completion pays them to the OTHER party, REJECTED/CANCELLED
   * returns them to the payer. See Offer.bridgeFeeLeaves.
   */
  bridgeFeeLeaves Int?

  /**
   * WHICH SIDE PAID IT. True when the sender (the proposer) did, false when
   * the receiver did, NULL when there is no fee.
   * NOT DERIVED, and that is the point. The payer is the side handing over the
   * lower-bracket item, which is a fact about the two items AT THE MOMENT THE
   * OFFER WAS AGREED -- and a value can be edited afterwards, an item can be
   * re-valued, an admin can approve a review. Re-deriving it at completion
   * would mean the Leaves could be paid to the wrong person because somebody
   * edited a listing in between. Settlement and cancellation read this column
   * and nothing else.
   * A boolean against `senderId` rather than a `bridgeFeePayerId` FK, the same
   * argument `meetupProposedBySender` makes: an id column can point at
   * somebody who is not in this trade, and then every reader has to guard
   * against a state the column let us write.
   */
  bridgeFeePaidBySender Boolean?

  // ── Offer-phase snapshots (were Offer columns) ─────────────────────────────
  //
  // `offeredBracket` / `targetBracket` are SNAPSHOTS of the two brackets at
  // proposal, for the audit trail and for the accept-time re-check to name what
  // moved. They are not read as the rule -- the rule is re-derived from
  // `Item.valueLeaves` on every check. `consentAt` / `policyVersion` record the
  // PAYER ticking "I agree to the bridging fee and the trading policy";
  // required on a bridge, absent on a same-bracket deal. See @/lib/bridge-fee.
  offeredBracket Int?
  targetBracket  Int?
  consentAt      DateTime?
  policyVersion  String?   @db.VarChar(32)

  messages  Message[]
  reviews   Review[]
  swapCodes SwapCode[]

  @@index([senderId])
  @@index([receiverId])
  @@index([offeredItemId])
  @@index([requestedItemId])
  @@index([safeZoneHubId])
  @@index([meetupHubId])
  /// The lazy offer-expiry sweep and the "pending offers" lists.
  @@index([offerStatus, createdAt])
  /// Live trades: the escrow check and the trades screen.
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.Text
  systemEventKey String?  @unique
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  tradeId String?
  trade   Trade?  @relation(fields: [tradeId], references: [id])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([senderId])
  @@index([receiverId])
  @@index([tradeId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  // Structured navigation target, kept SEPARATE from `type`.
  //
  // `type` is the EVENT that happened; entityType/entityId are WHAT TO OPEN.
  // They do not map one-to-one — TRADE_ACCEPTED and NEW_MESSAGE both point at a
  // chat partner, while TRADE_COMPLETED points at a list with no id at all.
  // Collapsing the two is the mismatch that bites later.
  //
  // entityType is a plain string, not an enum: the set of navigable targets
  // grows with the mobile client and each addition would otherwise cost a
  // schema migration for what is just a routing token.
  //
  // TWO VOCABULARIES LIVE IN THIS COLUMN. That is deliberate, and knowing which
  // one a row uses is a matter of when it was written.
  //
  //   v1 and later (what new writes use) — the fine-grained set:
  //     "conversation"   entityId = the other participant's userId
  //     "trade"          entityId = the tradeId
  //     "review"         entityId = the reviewId
  //     "follow_request" entityId = null
  //     "report"         entityId = the reportId (REPORT_RESOLVED)
  //
  //   pre-v1 (the migrated rows) — a coarse set the old `link` column could
  //   actually support:
  //     "user"   entityId = a userId, or null
  //     "trade"  entityId = ALWAYS null
  //
  // The distinction that matters is "conversation" vs "user": a notification
  // about a message opens a THREAD WITH someone, not their profile. The old
  // links could not express that difference, which is why the backfill could
  // not either.
  //
  // CAVEAT ON PRE-v1 ROWS. The backfill recovered only what the old `link`
  // encoded, and trade notifications encoded a chat partner. So rows written
  // before /api/v1 — TRADE_ACCEPTED in particular — carry ('user', <userId>)
  // rather than ('trade', <tradeId>). Deliberately not corrected: they are
  // already imperfect and they retire with the web user-side routes. Never read
  // a pre-v1 TRADE_* entityId as a trade id.
  //
  // `link` (a web URL) is KEPT in schema v2 although it is a known 3NF
  // redundancy: it is derivable from type + entityType/entityId, and about 20
  // routes still write it and the web admin and dashboard read it. Kept on
  // purpose (user decision, 3 Oct 2026); removing it is a separate change.
  entityType String?
  entityId   String?

  userId  String
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
  @@index([actorId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id])

  @@unique([tradeId, reviewerId])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([reviewerId])
  @@index([revieweeId])
}

enum TaskKind {
  VERIFY_ACCOUNT
  COMPLETE_PROFILE
  FIRST_LISTING
  // LEGACY. Paid 20 Leaves per completed trade until 16 Sep 2026, when the
  // per-trade payout became TRADE_REWARD (2 x bracket, see @/lib/trade-rules).
  // The value stays for the rows already written; nothing awards it now.
  VERIFIED_SWAP
  SAFEZONE_MEETUP
  // One-time: the first trade this account ever completed. What replaced the
  // per-trade VERIFIED_SWAP as a task -- a milestone, not a faucet.
  FIRST_TRADE
}

enum QuestTier {
  EASY
  MEDIUM
  HARD
}

enum QuestKind {
  // ── EASY pool ──
  SEND_OFFER
  FOLLOW_TRADER
  LEAVE_REVIEW
  // ── MEDIUM pool ──
  LIST_ITEM
  RECEIVE_OFFER
  SEND_BRIDGE_OFFER
  // ── HARD pool ──
  COMPLETE_TRADE
  COMPLETE_BRIDGE_TRADE
  COMPLETE_SAFEZONE_TRADE
}

/// One party's handoff code for one trade (was SwapConfirmationCode; renamed in
/// schema v2, columns unchanged). It belongs to a TRADE, which is why it is not
/// folded into AuthToken: it dies with the trade and is never a login credential.
model SwapCode {
  id       String  @id @default(cuid())
  tradeId  String
  trade    Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  used     Boolean @default(false)

  /**
   * The same code, sealed so its OWNER can be shown it. AES-256-GCM, keyed from
   * SWAP_CODE_KEY in the environment and never from anything in this database.
   * ADDITIVE, NOT A REPLACEMENT. `codeHash` above is still what confirm/submit
   * verifies against and nothing about the guess budget changes; this column is
   * read on exactly one path -- the owner asking confirm/status for their own
   * code -- so a fault here cannot make a wrong code verify.
   * NULL is a first-class value. A deployment with no key seals nothing, the
   * status route answers `code: null`, and the client points the reader at the
   * email exactly as it does today. Rotating the key leaves old rows unopenable
   * and that is a fifteen-minute problem, not a data-loss one -- see the long
   * note in @/lib/swap-code-seal.
   * The ciphertext is bound to (tradeId, userId) as GCM additional authenticated
   * data, so a value moved between rows by anyone with write access fails to
   * open rather than yielding one person's digits to another.
   */
  codeSealed String? @db.Text

  // Wrong guesses against THIS code. A 6-digit code is a 1-in-a-million secret
  // only while the number of guesses is bounded; unbounded, a trade participant
  // can grind their partner's code and complete a "verified in-person swap"
  // without ever meeting — which is exactly what the VERIFIED_SWAP and
  // SAFEZONE_MEETUP Leaf awards are paid for. At MAX_CODE_ATTEMPTS the code is
  // burned and both parties have to restart.
  attempts Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tradeId, userId])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
}

enum Category {
  ELECTRONICS
  CLOTHING
  BAGS
  BEAUTY
  ACCESSORIES
  FURNITURE
  BOOKS
  GAMING
  SPORTS
  BIKES
  TOYS
  TOOLS
  MUSIC
  ART
  COLLECTIBLES
  PETS
  PLANTS
  FOOD
  SERVICES
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  AVAILABLE
  IN_TRADE
  TRADED
  OWNED
  REMOVED
  /**
   * The owner asked for a value more than one bracket above the suggestion,
   * and an admin has not yet said yes. A STATUS rather than a flag because
   * every discovery query in this codebase already filters on
   * `status: AVAILABLE`, so a listing in review is invisible to everyone but
   * its owner and the admin Anomalies tab without a single WHERE clause
   * changing. Approve moves it to AVAILABLE at the requested value. Reject
   * does NOT publish it: it moves to VALUE_REJECTED, the owner is told, and
   * they choose to relist at the suggestion, edit within the cap, or delete.
   */
  PENDING_REVIEW
  /**
   * The review said no. A SEPARATE STATUS from PENDING_REVIEW (18 Sep 2026)
   * so that "waiting for an admin" and "waiting for the owner" can be told
   * apart by every filter -- the Anomalies queue is the first, the owner's
   * shelf is the second, and a row that means both is a row nobody owns.
   * Same visibility as PENDING_REVIEW: nobody but the owner. Leaves it the
   * same three ways (list at the suggestion, edit within the cap, delete),
   * or by an overturned appeal, which publishes at the requested value.
   */
  VALUE_REJECTED

  /**
   * A perishable listing whose `tradeWithinHours` ran out. Written ONLY by the
   * expiry sweep, and only on a row with `isPerishable`.
   * A STATUS AND NOT A `expiredAt` COLUMN, for exactly the reason
   * PENDING_REVIEW is one: every discovery query in this codebase already
   * filters on `status: AVAILABLE`, so an expired listing leaves the feed, the
   * browse grid, the matcher and the offer paths the moment the sweep runs,
   * without a single WHERE clause changing. A timestamp beside AVAILABLE would
   * need adding to all of them, and the one that was missed would keep selling
   * yesterday's fish.
   * DISTINCT FROM `REMOVED`, which the owner sets and can undo with relist.
   * Expiry is a fact about the clock and relisting does not change it -- the
   * owner posts the next batch as the next listing, which is what a batch is.
   * Kept out of `moderationHiddenAt` for the opposite reason: nobody was
   * judged here.
   */
  EXPIRED
}

/**
 * WHY a value review was refused -- the part of the decision the owner is
 * shown. A closed list, like IdRejectionReason, so that the sentence the
 * owner reads is one this codebase wrote and not a moderator's aside; the
 * moderator's own note goes to the audit row only. Unlike the ID reasons
 * these are shown DELIBERATELY: a rejected value is something the owner is
 * being asked to fix, and they cannot fix what they are not told.
 */
enum ValueRejectionReason {
  OVERVALUED_FOR_CONDITION
  ABOVE_MARKET
  WRONG_CATEGORY
  PHOTOS_DO_NOT_SUPPORT_VALUE
  OTHER
}

enum TradeStatus {
  PENDING
  ACCEPTED
  CONFIRMING
  REJECTED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TRADE_REQUEST
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_COMPLETED
  TRADE_CANCELLED
  NEW_MESSAGE
  NEW_REVIEW
  FOLLOW_REQUEST
  FOLLOW_ACCEPTED
  // The outcome of a report the recipient filed. Google Play expects a reporter
  // to be told what happened, and /trust promises it in so many words.
  REPORT_RESOLVED
  // The outcome of an ID submission. TWO TYPES AND NOT ONE: the approval is
  // good news that unlocks posting, the rejection carries a specific fix and a
  // remaining-attempts count, and a client that wants to style them differently
  // should not have to read the message text to tell them apart.
  ID_VERIFICATION_APPROVED
  ID_VERIFICATION_REJECTED
  /**
   * An offer of the recipient's own aged out unanswered. Sent to the SENDER
   * only — the receiver is the one who did not reply, and telling them so is a
   * reproach rather than information. It carries the released Leaves in its
   * message because that is the part the sender can act on.
   */
  OFFER_EXPIRED
  /**
   * The other party proposed, or agreed, a place and time to meet.
   * TWO NEW VALUES RATHER THAN REUSING TRADE_ACCEPTED, because this column is
   * the EVENT and a proposal is not an acceptance — the model's own note draws
   * that line. They also need different words and different urgency: a proposal
   * is a question waiting on the recipient, an agreement is a settled fact.
   * Both carry entityType "meetup", which is a NEW routing token and not
   * "trade": a trade notification opens the confirmation codes, and sending
   * somebody there to answer "can you do Saturday?" would put a 15-minute code
   * on screen days before the meeting.
   */
  MEETUP_PROPOSED
  MEETUP_AGREED
  /**
   * The outcome of a value review on the recipient's own listing. Two types
   * for the same reason ID verification has two: the approval says "it's
   * live", the rejection carries a choice the owner has to make.
   */
  LISTING_VALUE_APPROVED
  LISTING_VALUE_REJECTED
  /**
   * A moderator hid the recipient's listing. Until 18 Sep 2026 a takedown
   * told the owner nothing: the tile stayed on their shelf and opening it
   * 404ed. Carries no reason and no actor -- the appeal screen says what a
   * takedown is and how to answer it.
   */
  LISTING_HIDDEN
  /**
   * The outcome of the recipient's appeal. Two types, same reason as above.
   */
  LISTING_APPEAL_UPHELD
  LISTING_APPEAL_OVERTURNED

  /**
   * Somebody posted a listing in a category the recipient said they were
   * looking for. THE ONLY NOTIFICATION IN THIS ENUM THAT NOBODY DID TO THE
   * RECIPIENT -- every other one names an actor who acted on them, and this one
   * is a shop window.
   * That difference is why it is one type and not two: there is no approve/
   * reject pair to tell apart, and a client that wants to mute discovery
   * without muting trades needs exactly this value to filter on. It carries
   * entityType "item" with the NEW listing's id, which is a new routing token
   * -- not "trade" and not "conversation", because the only useful destination
   * is the listing itself.
   */
  CATEGORY_MATCH

  /**
   * An organisation owner invited the recipient to its staff. Before 25 Sep
   * 2026 an invitation made a PENDING row and told nobody: the invitee's only
   * way to find it was to open Settings for some other reason.
   * The actor is the OWNER who sent it, not the organisation's backing row --
   * a person asked, and the recipient should see who. entityType "org_invite",
   * entityId the OrganizationMember id, so the tap can open the invitation.
   * Withdrawing, accepting or declining deletes the row: a notification about
   * an invitation that no longer exists points at nothing.
   */
  ORG_INVITE

  /**
   * The recipient's perishable listing ran out of window unsold. Written only
   * by `expirePerishableItems()`, in the same transaction as the expiry, so
   * each listing is announced exactly once. No actor -- the clock did it.
   * entityType "listing_review", entityId the expired Item's id: the owner's
   * listing screen, whose expired state offers Relist (a NEW post prefilled
   * from this one, never an edit of it).
   */
  LISTING_EXPIRED
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

/// A like on a listing (was PostLike; renamed in schema v2, columns unchanged).
model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Item     @relation("ItemPostLikes", fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserPostLikes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
}

/// A comment on a listing (was PostComment; renamed in schema v2). Comment likes
/// were dropped with CommentLike, which never held a row.
model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Item      @relation("ItemPostComments", fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("UserPostComments", fields: [userId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  /**
   * The SENDER retracted it. Not the same act as DECLINED, which is the
   * receiver refusing, and the two must stay distinct: they are performed by
   * different people and they say different things about the sender.
   * Terminal, like the other two. `availableLeaves()` counts only PENDING
   * offers, so withdrawing releases the sender's pledged Leaves the moment the
   * status moves — no separate release step, and nothing to get out of step.
   */
  WITHDRAWN
  /**
   * Nobody acted within the window. Not DECLINED and not WITHDRAWN: those are
   * things a person DID, and this is the absence of one. Collapsing it into
   * DECLINED would tell a sender, permanently, that they were refused by
   * somebody who never opened the message.
   * The window is `OFFER_EXPIRY_DAYS` in @/lib/offers and is measured from
   * `createdAt` rather than stored per row — see the note there. Reached by a
   * lazy sweep on the read paths that measure a balance, because nothing on
   * this deployment runs on a schedule.
   */
  EXPIRED
}

enum LeafTxType {
  TRADE_SPEND
  TRADE_RECEIVE
  TASK_REWARD
  SIGNUP_GRANT
  // Deferred Points Agreement settlement. Always written as a PAIR in one
  // transaction -- CONTRACT_PAY on the debtor for -n, CONTRACT_COLLECT on the
  // creditor for +n -- so the pair nets to zero and
  // SUM(User.leaves) == SUM(LeafTransaction.amount) survives every payment.
  CONTRACT_PAY
  CONTRACT_COLLECT
  // ── Bracket trading (16 Sep 2026) ──
  //
  // The bridging fee, in three rows over the life of one offer. HOLD is a real
  // debit -- the Leaves leave User.leaves the moment the offer is made -- so
  // SUM(User.leaves) == SUM(amount) keeps holding at every step. While the
  // offer lives, the held amount is in ESCROW: on no user's balance, and the
  // negative HOLD row is the only trace of it. Exactly one of RELEASE (back to
  // the proposer) or PAID (to the receiver) closes it, and the three then net
  // to zero. See @/lib/bridge-fee.
  BRIDGE_FEE_HOLD
  BRIDGE_FEE_RELEASE
  BRIDGE_FEE_PAID
  // ISSUANCE. New Leaves entering the system when a trade completes,
  // 2 x the bracket of the item that user gave -- never its value. The one
  // formula is tradeReward() in @/lib/trade-rules. REVERSAL is the admin undo,
  // negative, and is the only thing that ever decrements lifetimeLeaves.
  TRADE_REWARD
  TRADE_REWARD_REVERSAL
  // RETIRED (24 Sep 2026). Was the daily free-Leaves allowance for a live
  // Premium or VIP subscriber; dropped from the Premium perk list before it
  // ever paid out (zero rows of this type exist on the live ledger). The
  // value stays, per this file's own convention for a retired concept (see
  // TaskKind.VERIFIED_SWAP), rather than being removed -- Postgres cannot
  // drop an enum value cheaply, and there is nothing to award with it now.
  TIER_DAILY_GRANT
  // A completed weekly quest -- 5/10/20 Leaves for Easy/Medium/Hard. See
  // completeQuest() in @/lib/quests, which is the only writer.
  QUEST_REWARD
  // A SINK. The owner pays to feature a listing; the Leaves leave User.leaves
  // and go to nobody, so this row has no partner. SUM(User.leaves) ==
  // SUM(amount) still holds because the debit and this row commit together.
  // See boostItem() in @/lib/featured.
  FEATURE_BOOST
}

// Each row is one atomic Leaf movement (credit or debit).
// Leaves are non-monetary. The legitimate sources of a row:
//   - a completed trade settlement, which always writes a matching
//     TRADE_SPEND / TRADE_RECEIVE pair and nets to zero across users (legacy
//     offeredLeaves only, since 16 Sep 2026);
//   - a TASK_REWARD, written in the same transaction that increments both
//     leaves and lifetimeLeaves, and rate-limited by WEEKLY_TASK_LEAF_CAP;
//   - a bridging fee HOLD / RELEASE / PAID triple, see LeafTxType;
//   - a TRADE_REWARD, issuance on completion, see LeafTxType;
//   - a QUEST_REWARD, issuance for a completed quest, see LeafTxType
//     (TIER_DAILY_GRANT is retired issuance: counted, never written);
//   - a FEATURE_BOOST, a sink with no partner row, see LeafTxType.
//
// THE RECONCILIATION, in full, as scripts/lib/ledger-invariant.ts checks it:
//   SUM(User.leaves) == SUM(amount)                      every row, signed
//   SUM(User.leaves) + escrow == issuance                nothing minted outside
//     escrow   = -(HOLD + RELEASE + PAID)                the issuance types
//     issuance =  SIGNUP_GRANT + TASK_REWARD + TRADE_REWARD + TRADE_REWARD_REVERSAL
//                 + QUEST_REWARD + TIER_DAILY_GRANT
//                 + FEATURE_BOOST (negative: a sink)
//   escrow == SUM(bridgeFeeLeaves on live offers/trades) the ledger agrees with
//                                                        the rows it points at
//
// The two timestamps answer different questions and must not be conflated:
//   createdAt — when THIS ROW was written. Never backdated. For a backfill this
//               is the moment the backfill ran.
//   eventAt   — when the qualifying action actually happened (the trade
//               settling, the listing being posted). Equals createdAt on the
//               live path; for a backfilled award it is the historical event.
//
// WEEKLY_TASK_LEAF_CAP windows on eventAt, so an award is judged against the
// week it was earned in rather than the week it happened to be processed in.
model LeafTransaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeafTxType
  amount      Int // positive = credit, negative = debit (in Pasa Leaves)
  description String

  /// The deal (Trade.id) that caused this row. A plain column rather than a
  /// relation: the ledger points at things, nothing points back at the ledger.
  /// Since schema v2 this is ALSO where a fee HOLD/RELEASE points -- those rows
  /// used to carry an `offerId`, and the v2 trade migration rewrote each one
  /// to the id of the Trade that offer became (Trade.legacyOfferId keeps the
  /// old id). scripts/schema-v2/verify-v2.ts asserts every value resolves.
  tradeId    String?
  /// LEGACY. The DeferredContract this row paid down, for CONTRACT_PAY /
  /// CONTRACT_COLLECT. DPAs were retired on 16 Sep 2026 and the table was
  /// dropped in schema v2; the one FULFILLED contract's pair keeps its id here
  /// so the two rows still explain each other. Nothing writes it.
  contractId String?

  // ── Task rewards (schema v2; was the TaskCompletion table) ─────────────────
  //
  // A row with `task` set IS the task completion: the claim and the payment are
  // one row, so they can no longer disagree. One-time tasks use taskRefId ""
  // and repeatable ones the tradeId; the @@unique below is what makes every
  // award idempotent -- do not relax it. Postgres treats NULLs as distinct, so
  // every non-task row (task NULL) is outside the constraint.
  //
  // A DENIED award is a row too: amount 0, written when a rule (repeat partner,
  // weekly cap) refused it, so that the denial is permanent rather than
  // retried. SUM(amount) is unchanged by it, so the invariant is untouched.
  //
  // CHECKs in 20261003000001_schema_v2_ledger:
  //   (task IS NULL) = (taskRefId IS NULL)
  //   task IS NULL OR type = 'TASK_REWARD'
  task      TaskKind?
  taskRefId String?

  createdAt DateTime @default(now())
  eventAt   DateTime

  // No bare [userId] index: all three below lead with userId and back the FK.
  @@unique([userId, task, taskRefId])
  @@index([userId, createdAt])
  @@index([userId, eventAt])
}

// ── Moderation: roles, reports, blocks, audit ────────────────────────────────
//
// Google Play's UGC policy requires in-app reporting and in-app blocking before
// a marketplace app passes review. That is why these four models exist now
// rather than later. It is not why they are shaped the way they are.

/**
 * Privilege. The current system is intentionally ADMIN-only.
 * MODERATOR and SUPER_ADMIN were removed from the live role model to keep the
 * permission model simple and avoid ambiguity: ordinary users are USER, and
 * staff access is ADMIN only.
 */
enum Role {
  USER
  ADMIN
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
  /// A 24-hour story (1 Oct 2026). Added in its own migration and landed on
  /// main before any code writes it -- see SETUP.md on enum values.
  STORY
}

/**
 * Why the reporter says the content is wrong.
 * SCREAMING_SNAKE in the database, matching every other enum here, and the wire
 * carries the lower-case forms ("prohibited_item", "scam_or_fraud") through an
 * explicit closed map in @/lib/moderation. That is the same call
 * Item.valuationSource documents and for the same reason: a wire value
 * generated from a database enum name changes the day somebody renames the
 * enum, and a mobile client has already shipped against the old spelling.
 */
enum ReportCategory {
  SPAM
  PROHIBITED_ITEM
  SCAM_OR_FRAUD
  HARASSMENT
  COUNTERFEIT
  OTHER
}

/**
 * What kind of case a ModerationCase row is.
 */
enum ModerationCaseType {
  /// A user's report against a listing, user, message or story.
  REPORT
  /// An owner's appeal against a value rejection or a takedown on their listing.
  LISTING_APPEAL
}

/**
 * Where a case stands. ONE ENUM FOR BOTH TYPES (schema v2; was ReportStatus and
 * ListingAppealStatus), with the values each type may hold fixed by a CHECK
 * constraint in 20261003000000_schema_v2_core:
 * REPORT          OPEN, REVIEWING, ACTIONED, DISMISSED
 * LISTING_APPEAL  OPEN, UPHELD, OVERTURNED, WITHDRAWN
 * OPEN (and, for a report, REVIEWING) is LIVE. ACTIONED and DISMISSED are both
 * resolved, and the difference between them is whether anything happened to
 * the target, which is exactly what the reporter is told. WITHDRAWN is an
 * appeal closed because the owner deleted the listing -- no staff decision.
 */
enum ModerationCaseStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
  UPHELD
  OVERTURNED
  WITHDRAWN
}

/**
 * One case in the moderation queue (schema v2; was Report + ListingAppeal).
 * Both were "somebody asked staff to decide something, and staff decided":
 * a filer, a status, a decider, a decision time and a note to the filer. Those
 * are shared columns here. What differs is WHAT the case is about, and that
 * is per type -- the columns of the other type are NULL, enforced by CHECK
 * constraints in 20261003000000_schema_v2_core:
 * REPORT          targetType, targetId, category NOT NULL; itemId, appealKind,
 * message, actionId NULL. notes optional.
 * LISTING_APPEAL  itemId, appealKind, message, actionId NOT NULL; targetType,
 * targetId, category, notes, openKey NULL.
 * ── A REPORT'S TARGET IS A (type, id) PAIR, NOT A FOREIGN KEY ──────────────
 * A report must survive its target. A scam listing that gets deleted, by its
 * owner or by us, is precisely the report a moderator still needs to read, and
 * an FK with ON DELETE CASCADE would erase the evidence at the moment it started
 * mattering. The route validates that the target exists at report time.
 * An APPEAL's listing, by contrast, IS a foreign key (Cascade): the appeal is
 * about the owner's own listing and means nothing without it.
 * ── ONE APPEAL PER DECISION ──────────────────────────────────────────────────
 * `actionId` is the id of the AdminAction being appealed (a
 * LISTING_VALUE_REJECTED or LISTING_HIDDEN row), UNIQUE: a rejection can be
 * appealed once. A foreign key since 20261004000000_schema_v2_audit_fixes
 * (Restrict): audit rows are never deleted, so the FK costs nothing and makes
 * a dangling appeal impossible. NULL on every REPORT row, which a unique index
 * permits any number of.
 * ── ONE LIVE REPORT PER REPORTER PER TARGET: `openKey` ───────────────────────
 * Holds the literal "live" while a REPORT is OPEN or REVIEWING and NULL once it
 * is resolved, so the @@unique below permits exactly one live report per
 * (reporter, target) and any number of resolved ones. NULL on every appeal row.
 * WRITTEN BY THE APPLICATION, in the same statement that sets `status` -- see
 * resolveReport() in @/lib/moderation. It was going to be a STORED generated
 * column; MariaDB 10.4.32 hangs the whole server on an UPDATE to a table with
 * a stored generated column inside a unique index. On Postgres a partial
 * unique index would now do it; that is week-2 code work, not a data change.
 */
model ModerationCase {
  id   String             @id @default(cuid())
  type ModerationCaseType

  /// The reporter (REPORT) or the listing owner (LISTING_APPEAL).
  filedById String
  filedBy   User   @relation("ModerationCaseFiler", fields: [filedById], references: [id], onDelete: Cascade)

  status ModerationCaseStatus @default(OPEN)

  // ── REPORT only ──
  targetType ReportTargetType?
  targetId   String?
  category   ReportCategory?
  /// Free text from the reporter. Capped at MAX_REPORT_NOTES in @/lib/moderation.
  notes      String?           @db.Text
  openKey    String?           @db.VarChar(4)

  // ── LISTING_APPEAL only ──
  itemId     String?
  item       Item?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  appealKind ListingAppealKind?
  /// The owner's own words, capped at 300 characters. Never edited.
  message    String?            @db.VarChar(300)
  /// The AdminAction this appeal answers. Unique: one appeal per decision.
  /// Restrict: a decision cannot be deleted while an appeal against it exists
  /// (the app never deletes audit rows; test cleanups delete the appeal first).
  actionId   String?            @unique
  action     AdminAction?       @relation("AppealedAction", fields: [actionId], references: [id], onDelete: Restrict)

  // ── The decision, both types ──
  /// Who closed it. SetNull: the case outlives the staff account.
  decidedById  String?
  decidedBy    User?     @relation("ModerationCaseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  /// REPORT: what the reporter is told (goes verbatim into REPORT_RESOLVED).
  /// LISTING_APPEAL: the decision reason, or what happened on WITHDRAWN.
  decisionNote String?   @db.Text

  createdAt DateTime @default(now())

  /// Audit rows that answered this case.
  actions AdminAction[] @relation("CaseActions")

  // Also backs the filedById FK, so there is no separate [filedById] index.
  @@unique([filedById, targetType, targetId, openKey])
  /// The queue: one type, filtered by status, oldest or newest first.
  @@index([type, status, createdAt])
  /// "everything ever filed against this listing" -- the report detail screen.
  @@index([targetType, targetId])
  @@index([itemId])
  @@index([decidedById])
}

/**
 * A one-way wall. blocker stops seeing, and stops being reachable by, blocked.
 * ONE ROW, NOT TWO. A block is asymmetric as an act -- only the blocker chose it
 * and only the blocker can undo it -- and symmetric in effect, because every
 * enforcement point queries BOTH directions (blocksMade none + blocksReceived
 * none). Writing a mirror row would make "who blocked whom" unrecoverable,
 * which is the one fact a moderator reading a harassment report needs.
 * WHAT A BLOCK DOES NOT DO: cancel a trade, void a DeferredContract, or delete
 * a message. See the note above enforceNotBlocked() in @/lib/blocking -- a
 * block that could rewind an obligation would be a debtor's escape hatch from
 * a creditor, and the block button is not a contract-reversal button.
 */
model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  // Every feed query asks "has anyone blocked me?", which reads this side.
  @@index([blockedId])
}

/// Which government ID was presented.
///
/// STUDENT IDs ARE ABSENT AND THAT IS THE POINT OF THE LIST. They are held
/// disproportionately by minors -- this platform is 18+, see User.dateOfBirth --
/// and they are the easiest document here to forge convincingly, because every
/// school prints its own and no reviewer can know what any given one looks
/// like. The seven below are all issued by a national agency against a
/// registry, which is what makes "does this look right?" a question a
/// non-expert reviewer can actually answer.
///
/// SCREAMING_SNAKE here, lower_snake on the wire through the closed map in
/// @/lib/id-verification -- the same call ReportCategory and SafeZoneType
/// document, for the same reason.
enum IdType {
  NATIONAL_ID
  DRIVERS_LICENCE
  PASSPORT
  UMID
  PHILHEALTH
  POSTAL_ID
  VOTERS_ID
}

enum IdVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a submission was refused.
///
/// A CLOSED LIST AND NOT FREE TEXT, because the whole value of a rejection is
/// that the person can fix it and try again. "Rejected" tells them nothing;
/// "the photo is too blurry to read" tells them to retake it in better light.
/// Free text would let a tired reviewer type "no" at 1am and burn one of the
/// three attempts a real user gets.
enum IdRejectionReason {
  BLURRY_PHOTO
  NAME_MISMATCH
  EXPIRED_ID
  WRONG_DOCUMENT_TYPE
  NOT_GOVERNMENT_ID
}

/**
 * One submitted government ID, and what was decided about it.
 * THE RETENTION RULE IS THE DESIGN OF THIS TABLE, not a policy written beside
 * it. This is government ID data under RA 10173, and the shape below is what
 * makes "we do not keep a folder of scanned IDs" a structural fact rather than
 * a promise:
 * the ID NUMBER  is only ever stored as a SHA-256 digest. The plaintext
 * exists in the request body and in nothing else -- not a
 * column, not a log line, not the admin queue.
 * the IMAGE      lives in a private Cloudinary folder for as long as the row
 * is PENDING, and is destroyed when a decision is made.
 * Approve or reject; the image goes either way.
 * what SURVIVES  the digest, the ID type, the outcome, who decided it and
 * when. Enough to audit a decision and enough to enforce one
 * ID per account, and nothing else.
 * A row is never deleted by a decision -- only by the deletion of the account
 * it belongs to, which is what frees the ID for re-use. See deleteAccount().
 */
model IdVerification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("IdVerificationSubject", fields: [userId], references: [id], onDelete: Cascade)

  idType IdType

  /**
   * SHA-256 of the normalised ID number. NEVER THE NUMBER.
   * Normalisation (case, spaces, dashes) happens in @/lib/id-verification and
   * has to, or "S01-2345-678" and "s012345678" are two different people to this
   * column and the same person to a reviewer.
   * SHA-256 and not bcrypt, matching EmailVerificationToken.tokenHash and for a
   * related reason: this digest is looked up, not verified against a candidate.
   * The uniqueness check is a unique-index hit on a digest computed from the
   * submitted number, which a work factor would make impossible. The trade-off
   * is honest and worth naming: an ID number is low-entropy enough to be
   * brute-forced from a digest by anyone holding this table, so the digest is a
   * defence against casual reading and against the number leaking into a
   * backup, NOT against a determined attacker with the database. Storing the
   * number itself would be strictly worse in every one of those cases.
   */
  idNumberHash String @db.VarChar(64)

  /**
   * "One government ID, one account" as a database constraint.
   * The same trick as Report.openKey, and the same reason it cannot be a
   * generated column. This holds a COPY of idNumberHash while the row is
   * PENDING or APPROVED, and NULL once it is REJECTED. MySQL treats NULLs as
   * distinct in a unique index, so the @@unique below permits exactly one live
   * claim per ID number and any number of rejected ones.
   * WHICH IS THE WHOLE RULE FROM THE SPEC, expressed once:
   * REJECTED  frees the ID -- a real person whose photo was blurry must be
   * able to send the same ID again, and so must a second household
   * member if the first submission was a mistake.
   * APPROVED  does not. Otherwise a suspended user creates a new account and
   * re-presents the same ID, and the suspension means nothing.
   * PENDING   does not either. Two accounts racing the same ID through the
   * queue must not both be able to win.
   * DELETED   frees it, by the row being removed with the account.
   * WRITTEN BY THE APPLICATION, in the same statement that sets `status`, and
   * never on its own. MariaDB 10.4.32 hangs the entire server on an UPDATE to a
   * table with a STORED generated column inside a unique index; see the note on
   * Report.openKey, which is where that was found out.
   */
  claimKey String? @db.VarChar(64)

  status          IdVerificationStatus @default(PENDING)
  rejectionReason IdRejectionReason?

  /**
   * Who decided. SetNull: the decision outlives the staff account that made it.
   */
  reviewedById String?
  reviewedBy   User?     @relation("IdVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())

  /**
   * Which attempt this was: 1, 2 or 3.
   * A SNAPSHOT, NOT THE ENFORCEMENT. The cap is enforced by counting this
   * user's rows at submission time, because a stored counter and the rows it
   * counts are two things that can disagree -- and the direction they disagree
   * in here decides whether somebody gets a fourth try at a document they have
   * already been refused three times for. This column is what the reviewer and
   * the user read ("attempt 2 of 3"); the COUNT(*) is what refuses the fourth.
   */
  attemptCount Int

  /**
   * The uploaded photo, while it exists. NULL is the steady state.
   * Both columns are populated only between submission and decision, and they
   * are cleared on different schedules ON PURPOSE:
   * imageUrl       nulled inside the decision transaction. Once a decision is
   * made nothing may render this image again, and that must be
   * true the instant the decision commits -- it cannot wait on
   * a network call to Cloudinary.
   * imagePublicId  nulled only once Cloudinary confirms the destroy. It is
   * the delete key, so nulling it before the file is gone
   * would strand the file with nothing left pointing at it.
   * A decided row with a non-null imagePublicId is therefore exactly the set of
   * images that still need destroying, which is what the retry sweep queries.
   * See sweepUndeletedIdImages() in @/lib/id-verification.
   */
  imageUrl      String? @db.Text
  imagePublicId String? @db.VarChar(255)

  /**
   * When Cloudinary confirmed the destroy.
   */
  imageDeletedAt      DateTime?
  /**
   * When a destroy last failed. Non-null with imagePublicId non-null = retry me.
   */
  imageDeleteFailedAt DateTime?

  createdAt DateTime @default(now())

  // The live claim on an ID number. See claimKey.
  @@unique([claimKey])
  // "this user's submissions, newest first" -- the status screen and the cap.
  @@index([userId, submittedAt])
  // The queue: PENDING, oldest first.
  @@index([status, submittedAt])
  // The retry sweep: decided rows whose image is still up there.
  @@index([status, imagePublicId])
  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([reviewedById])
}

enum AdminActionKind {
  REPORT_REVIEWING
  REPORT_DISMISSED
  REPORT_ACTIONED
  LISTING_HIDDEN
  LISTING_UNHIDDEN
  USER_SUSPENDED
  USER_UNSUSPENDED
  HUB_CREATED
  HUB_UPDATED
  HUB_DEACTIVATED
  HUB_REACTIVATED
  ID_VERIFICATION_APPROVED
  ID_VERIFICATION_REJECTED
  ROLE_CHANGED
  /**
   * An offer of the recipient's own aged out unanswered. Sent to the SENDER
   * only — the receiver is the one who did not reply, and telling them so is a
   * reproach rather than information. It carries the released Leaves in its
   * message because that is the part the sender can act on.
   */
  OFFER_EXPIRED
  // ── Bracket trading (16 Sep 2026) ──
  // A value review decided, either way. `detail` carries both numbers.
  LISTING_VALUE_APPROVED
  LISTING_VALUE_REJECTED
  // The TRADE_REWARD on a completed trade taken back from both parties. The
  // reward ONLY -- the bridging fee stays with the receiver, because the
  // items changed hands in person and nothing here can undo that.
  TRADE_REWARD_REVERSED
  // An admin cancelled a trade on the parties' behalf (test data, a dispute).
  TRADE_CANCELLED
  // ── Listing appeals (18 Sep 2026) ──
  // An owner's appeal against a value rejection or a takedown, decided.
  // `detail` carries both values, the appealed AdminAction's id, and
  // `sameReviewer: true` when the decider is the one who rejected it.
  // OPENING an appeal writes no row here: the actor of an AdminAction is
  // staff, and the ListingAppeal row itself is the immutable record of the
  // owner's step.
  LISTING_APPEAL_UPHELD
  LISTING_APPEAL_OVERTURNED
  // ── Achievements (admin surface) ──
  // An admin created, edited, activated or deactivated an achievement
  // definition. `detail` carries the prior/new field values. Deactivating
  // rather than deleting is the rule: a UserAchievement row points at this
  // definition, and deleting it would take every earned copy with it.
  ACHIEVEMENT_CREATED
  ACHIEVEMENT_UPDATED
  ACHIEVEMENT_DEACTIVATED
  ACHIEVEMENT_REACTIVATED
  /**
   * The outcome of a business-document review. TWO KINDS, matching the ID
   * pair above, because an audit log that records "a decision was made" and
   * not which one is an audit log you have to open the target row to read.
   */
  ORGANIZATION_VERIFIED
  ORGANIZATION_REJECTED
}

enum AdminTargetType {
  REPORT
  LISTING
  USER
  HUB
  ID_VERIFICATION
  TRADE
  LISTING_APPEAL
  ACHIEVEMENT
  ORGANIZATION
}

/**
 * The audit trail. Who did what, when, and why.
 * Moderation without an audit row is indistinguishable from abuse: a suspended
 * user, a hidden listing and a dismissed report all look the same whether a
 * moderator followed the policy or settled a grudge, and the only difference
 * that can ever be recovered is the one that was written down at the time.
 * `reason` is NOT NULL AND NOT DEFAULTED. Every route that writes one of these
 * requires the moderator to type it. An optional reason is a reason nobody
 * fills in.
 * `actorId` has no onDelete, which on MySQL means RESTRICT: the database
 * refuses to delete a staff account that has moderated anything. Deleting a
 * moderator must not vacuum up the record of what they did.
 */
model AdminAction {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminActor", fields: [actorId], references: [id])

  action     AdminActionKind
  targetType AdminTargetType
  targetId   String

  /**
   * The moderation case this action answers, when there is one (was reportId;
   * renamed in schema v2 because a case may now be an appeal). Bulk cleanup has none.
   */
  caseId String?
  case   ModerationCase? @relation("CaseActions", fields: [caseId], references: [id], onDelete: SetNull)

  /// The appeal against this decision, if one was filed (ModerationCase.actionId).
  appeal ModerationCase? @relation("AppealedAction")

  reason String  @db.Text
  /**
   * JSON snapshot of what changed -- prior item status, prior suspension dates,
   * the listing title as it read at takedown. A plain Text column and not a
   * relation, matching LeafTransaction.tradeId: the audit records what it
   * acted on, it is not joined through.
   */
  detail String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  // FK-backing index for caseId.
  @@index([caseId])
}

// -- Safe-Zone Hubs ----------------------------------------------------------

/// What kind of public place this is. The type drives nothing but display and
/// filtering today; it exists so "meet at a police station" and "meet at a
/// mall" are distinguishable to a user deciding where they are comfortable
/// going, and to us when we look at which kinds of place people actually pick.
///
/// SCREAMING_SNAKE here, lower_snake on the wire through the closed map in
/// @/lib/safe-zones -- the same call Item.valuationSource and ReportCategory
/// document, and for the same reason: a wire value generated from a database
/// enum name changes the day somebody renames the enum, and a shipped mobile
/// client has already parsed the old spelling.
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────
// ACHIEVEMENTS -- MODELLED HERE AS OF 18 Sep 2026.
//
// These were pushed straight to the live database by an earlier pass (they had
// rows and appeared in no migration in this repository). They are modelled here
// now so `prisma migrate diff --from-config-datasource` stops proposing to DROP
// them every time it runs -- which it did, and which every hand-authored
// migration.sql had to strip out (20260918000000_value_rejection_appeals did).
// The models below match the live tables, plus THREE ADDITIONS this feature
// needs and the live tables did not have:
//
//   imageUrl         the uploaded badge art. `icon` stays as an emoji/text
//                    FALLBACK so badges created before an image was uploaded
//                    still render; a badge with an imageUrl shows the image.
//   homeDisplayOrder the single "featured" slot on the home feed. The display
//                    route already probes information_schema for this column,
//                    so the code was written half-expecting it; it is real now.
//   sortOrder        admin-controlled ordering for the achievements shelf.
//
// The accompanying migration is written to be ADDITIVE: it creates the tables
// if absent and adds the new columns if absent, and NEVER drops anything. See
// the header of that migration.sql for why that is the only safe shape here.
// ─────────────────────────────────────────────────────────────────────────────

enum ListingAppealKind {
  /**
   * Against a LISTING_VALUE_REJECTED decision. Overturn publishes at the requested value.
   */
  VALUE_REJECTION
  /**
   * Against a LISTING_HIDDEN takedown. Overturn clears moderationHiddenAt.
   */
  MODERATION_HIDE
}

enum SafeZoneType {
  MALL
  BARANGAY_HALL
  POLICE_STATION
  PUBLIC_PLAZA
  TRANSPORT_HUB
}

/// A curated public meetup point.
///
/// THIS MODEL EXISTS INSTEAD OF PLOTTING SELLERS ON A MAP. The alternative --
/// rendering Item.pickupLat/pickupLng as pins -- publishes an approximate home
/// address for every seller who offers local pickup, and coarsening the pin
/// does not fix it: a 1 km circle around a listing that is renewed weekly from
/// the same house resolves to that house after a few observations. A hub is a
/// different kind of object. Nobody lives at a mall information desk, so its
/// coordinate carries no privacy cost to anyone.
///
/// WHICH IS WHY THESE COORDINATES ARE PRECISE AND PUBLIC, and must stay that
/// way. resolvePickup()'s 2-decimal rounding is a rule about SELLERS' homes and
/// it must never be applied here: a hub rounded to ~1.1 km lands somewhere in
/// the general vicinity of the mall, which is worse than useless to two people
/// trying to find each other, and it protects nobody. If you find yourself
/// reaching for coarsen() on a hub, the bug is the reach, not the precision.
///
/// `landmark` is REQUIRED and has no default, deliberately. "Meet at the mall"
/// is not a meeting point -- a mall has six entrances -- and an optional field
/// here is a field that is empty on the hubs somebody added in a hurry. The
/// admin route makes them type it.
///
/// DEACTIVATION, NOT DELETION. `isActive` false removes a hub from the picker
/// and from GET /api/v1/hubs; it does NOT touch the ItemSafeZone rows pointing
/// at it, and the relation below is Restrict so the database refuses a delete
/// that would. A listing already offered at a hub that closed keeps saying so,
/// flagged unavailable, because the alternative is a listing silently losing
/// the only answer it had to "where would we meet?".
model SafeZoneHub {
  id String @id @default(cuid())

  name String       @db.VarChar(120)
  type SafeZoneType

  address String @db.VarChar(300)

  /// PUBLIC AND PRECISE. See the note above -- never coarsened, never gated.
  latitude  Float
  longitude Float

  /// The LGU, as a plain string rather than an enum: the hub list grows city by
  /// city and adding Consolacion should be an INSERT, not a migration.
  city String @db.VarChar(80)

  /// The "where exactly" note -- "ground floor, near the information desk".
  /// Required; see the note above.
  landmark String @db.VarChar(200)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items ItemSafeZone[]

  /// Trades whose parties CLAIMED they met here. Restrict on that side too, so
  /// a hub carrying meetup history is as undeletable as one carrying listings.
  trades Trade[] @relation("MeetupClaim")

  /// Trades that have ARRANGED to meet here and not yet confirmed. The claim
  /// above is what happened; this is what is planned. Named relations because
  /// there are now two of them between this pair of models -- see the block on
  /// `TradeRequest.meetupHubId` for why they are not one column.
  meetupPlans Trade[] @relation("MeetupPlan")

  /// The picker's query: active hubs in one city. Both filter columns, in the
  /// order the WHERE clause names them.
  @@index([isActive, city])
}

/// Item to hub. "I am willing to meet you at any of these places."
///
/// COMPOSITE PRIMARY KEY rather than a cuid plus a unique index. The pair IS
/// the identity of this row -- there is no such thing as two different
/// associations between the same item and the same hub -- and expressing that
/// as the PK means a double-tapped save cannot produce a duplicate no matter
/// what the route does. It also drops one index and one column off what will be
/// the widest-fanning join in this schema.
///
/// onDelete differs on the two sides, and both directions are deliberate:
///
///   item -> Cascade.  A deleted listing's associations are meaningless and
///                     nothing audits them. Item deletion here is a soft delete
///                     anyway (status = REMOVED), so this fires rarely.
///
///   hub  -> Restrict. The database refuses to delete a hub any listing points
///                     at. This is the enforcement half of "deactivate, never
///                     delete": a hub row deleted out from under its
///                     associations would take the listings' only stated
///                     meeting place with it, and the admin surface exposes no
///                     delete for exactly this reason. Restrict is what makes
///                     the rule hold for somebody at a SQL prompt too.
model ItemSafeZone {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  hubId String
  hub   SafeZoneHub @relation(fields: [hubId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([itemId, hubId])
  /// "which listings are offered at this hub" -- GET /api/v1/hubs/[id]/items.
  /// The PK's leading column already serves the other direction.
  @@index([hubId])
}

// ── Achievements ─────────────────────────────
//
// A badge an admin defines, and the copy a user earns. The admin surface
// (src/app/admin/achievements) creates and edits the DEFINITION; the criteria
// engine in @/lib/achievements creates the EARNED row automatically when a
// user's activity matches.
//
// ── WHY A CLOSED CRITERION AND NOT A FREE-TEXT RULE ─────────────────────────
//
// `criterion` is an enum, not a script and not a sentence. "Grays out unless
// achieved" is only real if the SYSTEM decides, and the system can only decide
// what it can evaluate -- so the set of things a badge can be earned for is a
// closed list the code knows how to check, exactly like the ID-rejection reason
// list and for the same reason. An admin picks a criterion and a threshold;
// they never type a rule.
//
// `threshold` is read by criterion. For the boolean criteria (VERIFIED,
// PROFILE_COMPLETE, ID_VERIFIED) it is ignored and stored as 1; for the counted
// ones (LISTINGS, TRADES, LIFETIME_LEAVES, SAFEZONE_MEETUPS, REPORTS_FILED) it
// is the number that must be reached. One column for both because a NULL-able
// "threshold that means nothing for this criterion" is a column somebody reads
// and misinterprets.

enum AchievementCriterion {
  // ── THE LIVE VALUES, WHICH ARE THE SOURCE OF TRUTH ─────────────────────────
  //
  // These four are what the live "AchievementCriterion" enum already contained
  // when this surface was built, and there are real Achievement rows using
  // them. The enum here must match the database EXACTLY: Prisma sends these
  // names verbatim, so a value the schema has and the DB lacks fails at runtime
  // with "Value 'X' not found in enum" -- which is precisely the crash that
  // prompted this reconciliation. Do not re-spell them.
  //
  // VERIFIED_ACCOUNT is the mailbox check (User.isVerified), NOT the government
  // ID -- that is ID_VERIFIED, below, and the two are deliberately apart.
  VERIFIED_ACCOUNT
  /// An APPROVED IdVerification (or the grandfather stamp).
  ID_VERIFIED
  /// Items ever posted. Counted.
  FIRST_LISTING
  /// COMPLETED trades, either side. Counted.
  COMPLETED_TRADES
  // ── ADDED BY THIS FEATURE (18 Sep 2026) ─────────────────────
  //
  // Appended to the live enum by 20260919000001_achievement_criterion_values.
  // They extend the closed set @/lib/achievements can evaluate without
  // disturbing the four above.
  /// avatar, bio and location all filled in.
  PROFILE_COMPLETE
  /// User.lifetimeLeaves. Counted.
  LIFETIME_LEAVES
  /// COMPLETED trades that named a SafeZoneHub. Counted.
  SAFEZONE_MEETUPS
  /// Reports filed (a good-citizen badge, not a misconduct one). Counted.
  REPORTS_FILED
  // ── ADDED BY THE SWAN BADGE SET (23 Sep 2026) ────────────────
  //
  // Appended by 20260923000000_achievement_points_and_bridge_criterion.
  /// COMPLETED trades, either side, that carried a bridge fee (TradeRequest
  /// .bridgeFeeLeaves > 0) -- the value gap between two unequal-bracket items
  /// was bridged with Leaves, not just an even swap. Counted, same shape as
  /// COMPLETED_TRADES; see progressFor() in @/lib/achievements.
  BRIDGE_COMPLETED
  // ── PREMIUM PERK #4 (24 Sep 2026) ─────────────────────────────
  //
  // Boolean, same shape as VERIFIED_ACCOUNT: isPremium(User.premiumUntil) OR
  // isVip(User.vipUntil) at the moment evaluateAchievements() runs. Once
  // granted it behaves like every other achievement here -- PERMANENT, never
  // revoked -- so a lapsed subscription keeps the badge. That is not a special
  // case coded in; it falls straight out of the engine's existing rule that
  // nothing un-grants a UserAchievement row once written.
  PREMIUM_SUBSCRIBER
}

model Achievement {
  id String @id @default(cuid())

  /// Stable machine key ("verified", "first_trade"). Unique, because it is what
  /// code and seed scripts refer to a badge by when the cuid would change
  /// between environments.
  key         String @unique
  name        String
  description String @db.Text

  /// Emoji or short text, shown when imageUrl is null. Kept so every badge that
  /// existed before uploaded art still renders.
  icon String @default("🏆")

  /// Uploaded badge art (a public Cloudinary URL from /api/upload). Null falls
  /// back to `icon`.
  imageUrl String?

  criterion AchievementCriterion
  /// The number the criterion must reach. Ignored (stored 1) for booleans.
  threshold Int                  @default(1)

  /// Admin ordering for the shelf; ties broken by name.
  sortOrder Int @default(0)

  /// How much this badge is worth. Purely a stored number today -- nothing
  /// gates on it and it does not move Leaves -- summed client-side (or by a
  /// future route) into a user's total across their unlocked badges.
  points Int @default(0)

  /// DEACTIVATE, NEVER DELETE. A UserAchievement row points here, and deleting
  /// the definition would cascade away every copy a user earned. Inactive
  /// badges stop being listed and stop being awarded, but the earned rows --
  /// and the users wearing them -- survive.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unlocks UserProgress[]

  @@index([isActive, sortOrder])
}

/**
 * Which kind of progress a UserProgress row records.
 */
enum ProgressType {
  /// One daily quest assigned to one user (was QuestAssignment).
  QUEST
  /// One badge one user has earned (was UserAchievement).
  ACHIEVEMENT
}

/**
 * A user's progress on something the platform tracks for them (schema v2; was
 * QuestAssignment + UserAchievement). The columns of the other type are NULL,
 * enforced by CHECK constraints in 20261003000000_schema_v2_core:
 * QUEST        periodStart, tier, quest, rewardLeaves NOT NULL; completedAt
 * optional; achievementId, unlockedAt, displayOrder,
 * homeDisplayOrder NULL.
 * ACHIEVEMENT  achievementId, unlockedAt NOT NULL; displayOrder and
 * homeDisplayOrder optional; every quest column NULL.
 * Both uniqueness rules survive as plain unique indexes, because Postgres
 * treats NULLs as distinct: a QUEST row has a NULL achievementId and never
 * collides on (userId, achievementId); an ACHIEVEMENT row has a NULL
 * periodStart and never collides on (userId, periodStart, quest). The claim
 * patterns that lean on them (completeQuest(), the criteria engine's
 * skipDuplicates insert) keep working unchanged.
 * ── QUESTS ───────────────────────────────────────────────────────────────────
 * Daily quests (23 Sep 2026, moved weekly -> daily 24 Sep 2026) ────────────
 * Five quests a day: 2 Easy (2 Leaves each), 2 Medium (3 each), 1 Hard (5) --
 * 15 Leaves/day if every one is completed. Assigned fresh each UTC calendar
 * day (`periodStart`) and reconciled against real DB state the same way
 * TaskCompletion is -- see reconcileQuests() in @/lib/quests. Every quest is
 * an existing, already-tracked platform action (send an offer, list an item,
 * complete a trade); none of it is a new engagement metric like time-in-app,
 * which is deliberate -- the manuscript frames Baylo's Point System as a
 * reward system rather than gamification, and a metric with no real-world
 * action behind it would contradict that.
 * ONE ROW PER (user, day, quest), not per tier: unlike the original weekly
 * shape (one quest per tier), Easy and Medium each place TWO quests a day, so
 * the tier alone no longer identifies a row -- `quest` does, and the pools
 * are built so a QuestKind is never assigned twice in the same day.
 * `rewardLeaves` is snapshotted at assignment time so a later change to
 * QUEST_REWARDS never rewrites what a past day actually paid.
 * STACKS ON TOP OF WEEKLY_TASK_LEAF_CAP, DELIBERATELY. Quests write
 * QUEST_REWARD ledger rows, not TASK_REWARD, so the existing 100/week task
 * cap never sums them -- 15/day of quests is a second, separate allowance on
 * top of it, not a share of it. A conscious product decision, not an
 * oversight: see the header of @/lib/quests.
 * ── ACHIEVEMENTS ─────────────────────────────────────────────────────────────
 * CASCADE from both the user and the definition: an earned badge is
 * meaningless without either. `displayOrder` is the PROFILE shelf slot (1..4,
 * capped in the route), NULL = earned but not shown; `homeDisplayOrder` is the
 * single featured home slot. NULL displayOrder is a VALID state -- never
 * "repair" it by predicate.
 */
model UserProgress {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   ProgressType

  // ── QUEST ──
  /// The UTC calendar day this quest was assigned for.
  periodStart  DateTime?
  tier         QuestTier?
  quest        QuestKind?
  /// Snapshotted at assignment so a later change to QUEST_REWARDS never
  /// rewrites what a past day paid.
  rewardLeaves Int?
  /// Non-null means paid. Credits Leaves exactly once; see the claim guard in
  /// completeQuest() in @/lib/quests.
  completedAt  DateTime?

  // ── ACHIEVEMENT ──
  achievementId    String?
  achievement      Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  /// When the criteria engine granted it. The badge shows "Earned <date>".
  unlockedAt       DateTime?
  /// Profile shelf slot, 1-based. NULL = not displayed.
  displayOrder     Int?
  /// The one home-feed slot. NULL = not featured. At most one per user.
  homeDisplayOrder Int?

  /// When the row was written. For a migrated badge this is its unlockedAt
  /// (UserAchievement had no createdAt).
  createdAt DateTime @default(now())

  @@unique([userId, periodStart, quest])
  @@unique([userId, achievementId])
  @@index([userId, type, periodStart])
  @@index([userId, displayOrder])
  @@index([achievementId])
}

// ── Organisations / MSMEs ────────────────────────────────────────────────────

/**
 * What kind of business it is. A CLOSED LIST, and deliberately not `Category`.
 * Category is what an ITEM is; this is what a BUSINESS is, and the two only
 * look alike until the first sari-sari store, which sells across eight
 * categories and is none of them. Reusing Category would have forced every
 * multi-category shop to pick one and be wrong about it on their own profile.
 */
enum BusinessCategory {
  SARI_SARI
  FOOD_AND_BEVERAGE
  AGRICULTURE
  HANDICRAFT
  APPAREL
  ELECTRONICS_REPAIR
  SERVICES
  RETAIL
  COOPERATIVE
  NONPROFIT
  OTHER
}

/**
 * The outcome of the business-document review. THREE VALUES, MATCHING
 * IdVerificationStatus, because it is the same queue doing the same job to a
 * different document and a reviewer should not have to learn a second
 * vocabulary to work both tabs.
 */
enum OrgVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/**
 * Why a business document was refused. Closed, for the reason
 * IdRejectionReason is closed: the applicant has to be able to fix it, and
 * "rejected" is not something anybody can act on.
 */
enum OrgRejectionReason {
  BLURRY_DOCUMENT
  NAME_MISMATCH
  EXPIRED_REGISTRATION
  WRONG_DOCUMENT_TYPE
  NOT_A_BUSINESS_DOCUMENT
}

/**
 * An organisation or MSME (Micro, Small and Medium Enterprise, the DTI term) account.
 * ── IT IS A User ROW, AND THAT IS THE WHOLE DESIGN ──────────────────────────
 * Everything that makes an account visible on Baylo is a required foreign key
 * to User: Item.userId, Follow.followeeId, Message.senderId/receiverId,
 * Offer's two sides, TradeRequest's two sides, LeafTransaction.userId. An
 * Organization that were merely "a row beside a user" could own nothing, be
 * followed by nobody and hold no Leaves, and each of those would have needed
 * its own nullable column and its own second code path on every read.
 * So an organisation IS an account: `orgUserId` points at a User row created in
 * the same transaction, flagged `isOrgAccount`, and every existing FK keeps
 * working with no change at all. A staff member posting on the org's behalf
 * writes `Item.userId = orgUserId` -- the same column, the same query, the same
 * shape on the wire.
 * WHAT THE BACKING ROW IS NOT. It is not a person and it never logs in: it has
 * no password, and POST /api/auth/token refuses an `isOrgAccount` row outright.
 * Humans reach it only through OrganizationMember, and only by presenting their
 * OWN credentials plus an org context -- see resolveSession() and actingAs().
 * ── THE LEAF LEDGER IS UNTOUCHED ────────────────────────────────────────────
 * An org holds Leaves the way anybody does, on its own User row, so
 * SUM(User.leaves) == SUM(LeafTransaction.amount) stays true across orgs
 * without a single line of @/lib/leaves or @/lib/bridge-fee changing. That
 * invariant is the reason this model has no balance of its own, and adding one
 * later would break it.
 * ── AND THE TRUST LADDER IS NOT ─────────────────────────────────────────────
 * Organisations do not climb the trade-count trust tiers and do not carry a
 * leaf rank; their badge is this row's `verificationStatus` and nothing else.
 * Enforced by `isOrgAccount` on the backing row, which every reputation
 * aggregate excludes -- see notAnOrgWhere() in @/lib/organizations.
 */
model Organization {
  id String @id @default(cuid())

  /**
   * The User row this organisation IS. UNIQUE, so no two organisations can
   * share an account, and Cascade because the backing row and the org are one
   * thing -- deleting the account deletes the organisation with it, exactly as
   * deleting a user deletes their items.
   */
  orgUserId String @unique
  orgUser   User   @relation("OrganizationAccount", fields: [orgUserId], references: [id], onDelete: Cascade)

  name String

  /**
   * The square logo. A SEPARATE COLUMN FROM User.avatar even though the backing
   * row has one, because the two are rendered differently -- this one square,
   * the avatar round -- and a profile that has to guess which shape a URL wants
   * will get it wrong for somebody. Null renders the building-store placeholder
   * rather than initials.
   */
  logoUrl String? @db.Text

  /**
   * The wide cover image across the top of the storefront profile. PUBLIC, and
   * uploaded through POST /api/upload like a listing photo -- the opposite of
   * businessDocUrl below, which must never take that path. Null renders a
   * token-coloured band, so an org that never sets one does not look broken.
   */
  bannerUrl String? @db.Text

  /**
   * The shop's own one-paragraph pitch, shown under the category line. A
   * separate column from the backing row's User.bio on purpose: that is a
   * person's field on a person's edit screen, and this is edited by whichever
   * OWNER is signed in, from the shop's.
   */
  description String? @db.VarChar(500)

  /**
   * The DTI business-name registration number, AS TYPED by the applicant.
   * Stored and shown to the reviewer beside the document; never checked
   * against any DTI registry. Its only job is to let a reviewer compare the
   * number on the photograph with the number the applicant claims. Nullable
   * because organisations created before the field existed have none, and
   * unlike businessDocUrl it is NOT destroyed on decision -- a registration
   * number is a public business identifier, not a document about a person.
   */
  dtiRegistrationNumber String? @db.VarChar(64)

  businessCategory BusinessCategory

  verificationStatus OrgVerificationStatus @default(PENDING)

  /**
   * The DTI/SEC registration or barangay permit, WHILE IT EXISTS.
   * SAME RETENTION RULE AS IdVerification.imageUrl, and for the same reason:
   * this is a business document carrying a real person's name and address under
   * RA 10173. It is nulled inside the decision transaction, approve or reject,
   * and `businessDocPublicId` survives until Cloudinary confirms the destroy --
   * so a decided row with a non-null public id is exactly the set of files the
   * retry sweep still has to delete. Read the note on IdVerification before
   * changing either column; the split is not cosmetic.
   */
  businessDocUrl      String? @db.Text
  businessDocPublicId String? @db.VarChar(255)

  /**
   * When Cloudinary confirmed the destroy.
   */
  docDeletedAt      DateTime?
  /**
   * When a destroy last failed. Non-null with businessDocPublicId = retry me.
   */
  docDeleteFailedAt DateTime?

  /**
   * Why it was refused. Free of any reviewer's own words, like IdRejectionReason.
   */
  rejectionReason OrgRejectionReason?

  /**
   * Who decided. SetNull: the decision outlives the staff account that made it.
   */
  reviewedById String?
  reviewedBy   User?     @relation("OrganizationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  /**
   * THE ONE PERSON WHO MAY ACT AS THIS ORGANISATION (schema v2).
   * Was the OrganizationMember table, with OWNER and STAFF roles and PENDING
   * invitations. Staff were removed: every org-scoped authorisation decision
   * now reads this column, and "may this person act as this org" is
   * `ownerId = session.user.id`. A HUMAN row, never an org's backing row.
   * Restrict: account deletion anonymises a User rather than removing it, and
   * an owner row must not be removable out from under a live shop.
   */
  ownerId       String
  owner         User     @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// When the owner's membership became ACTIVE (OrganizationMember.joinedAt).
  ownerJoinedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The admin queue: PENDING, oldest first. Mirrors IdVerification's.
  @@index([verificationStatus, createdAt])
  /// The retry sweep: decided rows whose document is still up there.
  @@index([verificationStatus, businessDocPublicId])
  @@index([reviewedById])
  @@index([ownerId])
}

/**
 * The unit a perishable's `quantity` is counted in.
 * Three values, matching the wizard. An enum rather than free text because the
 * figure is rendered next to the number ("2 KG") and a text column is where
 * "kg", "Kg", "kilos" and "kilograms" all end up being the same unit spelled
 * four ways on four listings.
 */
enum QuantityUnit {
  KG
  PCS
  LITERS
}

// ── Stories (1 Oct 2026) ────────────────────────────────────────────────────

/// What a story shares. v1 is LISTING only; PHOTO is the planned second value
/// and arrives as an `ADD VALUE` plus a nullable column, not a reshaped table.
enum StoryType {
  LISTING
}

/// A 24-hour story: a person sharing one of their own AVAILABLE listings to
/// the row at the top of Community.
///
/// NOTHING SWEEPS THIS TABLE. A story is live while `expiresAt > now()`,
/// `deletedAt` is null and its listing is still AVAILABLE and not
/// moderation-hidden; every read applies that in SQL (liveStoryWhere() in
/// @/lib/stories), so an expired, deleted or traded-away story simply stops
/// matching. Expired rows are kept as the report trail for STORY reports.
///
/// PERSONAL ACCOUNTS ONLY in v1. The create path refuses an X-Baylo-Org
/// context and only shares listings the person owns, which a shop listing
/// (owned by the org's backing row) never is.
model Story {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation("StoryAuthor", fields: [userId], references: [id], onDelete: Cascade)
  type   StoryType @default(LISTING)

  /// The shared listing. Required for LISTING; nullable so PHOTO can arrive
  /// without reshaping. Cascade: a hard-deleted listing takes its stories.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  caption String? @db.VarChar(200)

  createdAt DateTime  @default(now())
  /// createdAt + 24 h, written by the application at create time.
  expiresAt DateTime
  /// Set when the author deletes the story. Kept rather than removed so a
  /// report against it still has something to show a moderator.
  deletedAt DateTime?

  views StoryView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([itemId])
}

/// "This viewer has seen this story" -- the ring colour in the stories row.
/// Server-side so it follows a person across devices and reinstalls.
model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  seenAt   DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([viewerId])
}
