generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?

  // Account verification. This flag — never "password is null" — is what
  // "verified" means. Google sign-in (web callback and native token exchange)
  // sets it, and so does the emailed verification link. Flipping it false ->
  // true is what triggers the VERIFY_ACCOUNT award and the one-time signup
  // grant; see markVerified().
  //
  // NOT the government-ID check. That is IdVerification below, it is derived
  // rather than flagged, and it gates posting and DPA proposals rather than the
  // signup grant. The two are separate on purpose and must not be folded
  // together.
  isVerified Boolean @default(false)

  // One-time signup grant (SIGNUP_GRANT_LEAVES), claimed at verification, never
  // at registration — an ungated grant lets an attacker mint Leaves by mass-
  // creating accounts. Set true in the SAME statement that credits the Leaves,
  // so two concurrent verifications cannot both pay out.
  signupGrantClaimed Boolean @default(false)

  // Date of birth, and the 18+ gate that reads it.
  //
  // A DATE column, not a DateTime: this is a calendar fact and it has no time
  // and no zone. Storing an instant means a user in UTC+8 born exactly eighteen
  // years ago is written as the day before, and for exactly that person on
  // exactly that day the column decides whether they may hold an account. See
  // src/lib/age.ts, which is the only place the arithmetic is done.
  //
  // NULLABLE, and it stays nullable. Every account created before this column
  // existed has no value here, and a required column would mean either
  // inventing dates of birth for real users or locking them out. New accounts
  // are refused without one — /api/auth/register requires it, and the Google
  // exchange reports `needsDateOfBirth` so the native client can ask for it —
  // so the null set only ever shrinks.
  dateOfBirth DateTime? @db.Date

  avatar      String?
  bio         String?  @db.Text
  location    String?
  rating      Float    @default(0)
  totalTrades Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Account deletion (DELETE /api/user). The row is ANONYMISED here, never
  // removed, and that is a ledger decision rather than a soft-delete habit:
  // LeafTransaction.userId is a foreign key with onDelete: Cascade, so dropping
  // the row would silently delete that user's ledger history and break
  // SUM(User.leaves) == SUM(LeafTransaction.amount) — the one invariant the
  // whole Leaf economy is checked against. Retiring the account keeps both
  // sides of that equation intact while the personal data is scrubbed.
  //
  // Non-null means gone: resolveSession() refuses these accounts, so an access
  // token issued before deletion stops working immediately.
  deletedAt DateTime?

  // Premium subscription. Null or in the past means not subscribed; there is no
  // boolean beside it, because a boolean would have to be flipped back by a job
  // when the term ends and this column simply stops being true.
  //
  // NOTHING WRITES THIS YET. Play Billing is the only lawful way to sell a
  // digital subscription inside the Android app and there is no Play Console
  // account to test it against, so the column is set by hand
  // (scripts/set-premium.ps1) and read by ONE place: isPremium() in
  // @/lib/premium. What it gates is ACQUIRING an item whose value bracket is
  // PREMIUM_MIN_BRACKET or above -- proposing for one, or accepting an offer
  // of one -- see @/lib/brackets. It never hides a listing and never gates
  // giving one away.
  premiumUntil DateTime?

  // VIP subscription (23 Sep 2026). Same shape and same caveats as
  // premiumUntil -- a date, not a boolean, set by hand today via
  // scripts/set-premium.ps1 and read by ONE place, isVip() in @/lib/premium.
  //
  // VIP is a SUPERSET of Premium, not a sibling of it: it gates acquiring an
  // item at VIP_MIN_BRACKET or above (see @/lib/brackets), and it ALSO passes
  // everything premiumUntil alone would -- a VIP subscriber never needs both
  // columns set. enforcePremiumForListing() checks vip before premium for
  // exactly that reason.
  vipUntil DateTime?

  // The UTC calendar day the daily Premium/VIP Leaves allowance was last paid,
  // so claimDailyTierGrant() in @/lib/tier-grant can tell "already paid today"
  // from "not paid yet" with a WHERE clause instead of a read-then-write --
  // the same concurrency shape as signupGrantClaimed above. NOT a boolean:
  // the grant repeats every day a subscription is live, and a boolean would
  // have to be reset by a job at midnight the way premiumUntil deliberately
  // is not.
  lastTierGrantAt DateTime?

  items                   Item[]
  sentRequests            TradeRequest[]           @relation("SentRequests")
  receivedRequests        TradeRequest[]           @relation("ReceivedRequests")
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  conversationHides       ConversationHide[]        @relation("ConversationHidesByViewer")
  hiddenFromConversations  ConversationHide[]        @relation("ConversationHidesByPartner")
  notifications           Notification[]           @relation("NotificationRecipient")
  triggeredNotifications  Notification[]           @relation("NotificationActor")
  reviewsGiven            Review[]                 @relation("ReviewsGiven")
  reviewsReceived         Review[]                 @relation("ReviewsReceived")
  following               Follow[]                 @relation("Follower")
  followers               Follow[]                 @relation("Followee")
  postLikes               PostLike[]               @relation("UserPostLikes")
  postComments            PostComment[]            @relation("UserPostComments")
  commentLikes            CommentLike[]            @relation("UserCommentLikes")
  sentOffers              Offer[]                  @relation("SentOffers")
  receivedOffers          Offer[]                  @relation("ReceivedOffers")
  leaves                  Int                      @default(0)
  lifetimeLeaves          Int                      @default(0)
  leafTransactions        LeafTransaction[]
  swapConfirmationCodes   SwapConfirmationCode[]
  taskCompletions         TaskCompletion[]
  questAssignments        QuestAssignment[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]

  // Deferred Points Agreements. No denormalised default counter and no
  // defaulted flag on this row on purpose: both are derived from these two
  // relations at read time. A stored counter is one more thing that can drift
  // out of step with the rows it summarises -- totalTrades above already has,
  // sitting one and two above the real COMPLETED trade count for two users --
  // and a derived penalty is one that a lazy deadline sweep cannot apply twice.
  contractsAsDebtor   DeferredContract[] @relation("ContractDebtor")
  contractsAsCreditor DeferredContract[] @relation("ContractCreditor")

  // ── Moderation ─────────────────────────────────────────────────────────────
  //
  // The first privileged concept in this codebase. Every other authorisation
  // decision here is ownership-based -- you may edit an item because it is your
  // item -- and that shape cannot express "may act on someone else's content",
  // which is the whole job of a moderator.
  //
  // NO API ROUTE WRITES THIS COLUMN. Not an admin-only one, not a
  // super-admin-only one, none. An endpoint that can grant ADMIN is a
  // privilege-escalation target whose entire value is saving somebody a SQL
  // prompt once a year, and the escalation is total: an ADMIN can suspend every
  // account including the ones that would notice. Promotion is:
  //
  //   UPDATE `User` SET `role` = 'ADMIN' WHERE `email` = '...';
  //
  // Enforced by absence, and by scripts/verify-moderation.ts, which greps the
  // route tree for any handler that reads `role` out of a request body.
  role Role @default(USER)

  // Account suspension, written only by POST /api/admin/users/[id] with
  // action "suspend" / "unsuspend".
  //
  // suspendedAt     non-null means suspended right now.
  // suspendedUntil  when it lifts. NULL WITH suspendedAt SET MEANS INDEFINITE --
  //                 not "already lifted". suspensionState() in @/lib/moderation
  //                 is the only correct reading of the pair; do not test either
  //                 column alone.
  //
  // Both are CLEARED on unsuspend rather than kept as history. That is the
  // opposite of DeferredContract.defaultedAt, and deliberately so: a default is
  // a fact about the debtor that the tier system keeps charging against, while a
  // lifted suspension is a moderation decision whose record belongs in
  // AdminAction, next to who lifted it and why. A suspension history smeared
  // across the User row would be a second, worse audit log.
  suspendedAt    DateTime?
  suspendedUntil DateTime?

  reportsMade     Report[]        @relation("ReportReporter")
  reportsResolved Report[]        @relation("ReportResolver")
  blocksMade      Block[]         @relation("Blocker")
  blocksReceived  Block[]         @relation("Blocked")
  adminActions    AdminAction[]   @relation("AdminActor")
  appealsMade     ListingAppeal[] @relation("ListingAppealOwner")
  appealsDecided  ListingAppeal[] @relation("ListingAppealDecider")

  // Earned achievements. See the Achievement/UserAchievement models at the
  // bottom of this file for the whole story -- this relation existed only as a
  // raw table in live until it was finally modelled here.
  achievements    UserAchievement[]

  // -- Government ID verification ---------------------------------------------
  //
  // NOT `isVerified`, AND THE TWO MUST NOT BE CONFLATED. `isVerified` above
  // means "this person controls this mailbox"; it costs nothing to obtain and
  // it gates nothing except the signup grant. This is the second, much heavier
  // one: a photographed government ID, reviewed by a human, gating the two acts
  // that can cost somebody else real property -- posting an item and proposing
  // a deferred agreement.
  //
  // THERE IS NO `idVerified` BOOLEAN ON THIS ROW, deliberately. The answer is
  // derived from the rows below (an APPROVED IdVerification, or the
  // grandfather stamp), for the reason the note on totalTrades records: a
  // denormalised copy of a fact is a fact that can drift out of step with the
  // rows that produced it, and this one decides whether a listing may exist.
  // See isIdVerified() in @/lib/id-verification, which is the only reading.
  idVerifications         IdVerification[] @relation("IdVerificationSubject")
  idVerificationsReviewed IdVerification[] @relation("IdVerificationReviewer")

  // The grandfather stamp: non-null means this account was let past the ID
  // gate WITHOUT a review, at the moment the gate was introduced.
  //
  // A TIMESTAMP AND NOT A BOOLEAN, and a column rather than a synthetic
  // IdVerification row. A synthetic row would need an idType and an
  // idNumberHash that do not exist, would have to be excluded from the
  // uniqueness index by hand, and would read in the admin queue as a decision
  // somebody made. This says exactly what happened: nobody looked at an ID for
  // this account, and here is when we decided not to. Cleared by an ADMIN if a
  // grandfathered account should be made to submit after all.
  idVerifiedGrandfatheredAt DateTime?

  // Soft-delete and suspension sweeps. Raw CREATE INDEX in the old chain;
  // declared here so they survive the squash.
  @@index([deletedAt])
  @@index([suspendedAt])
}

model Follow {
  id        String       @id @default(cuid())
  status    FollowStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User   @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([followeeId])
}

// Refresh tokens for the native (React Native) client. The web admin side keeps
// its NextAuth cookie session and never touches this table.
//
// Three properties do the security work, and none of them is optional:
//   HASHED     — only the SHA-256 of the token is stored, so a database read
//                does not hand out usable credentials.
//   SINGLE USE — `usedAt` is stamped the first time a token is redeemed.
//                Redeeming it again is, by definition, either a replay or a
//                thief racing the legitimate client.
//   FAMILY     — every token minted from the same original login shares a
//                `familyId`. A replay revokes the WHOLE family, which logs out
//                both the thief and the victim rather than letting the thief
//                quietly keep rotating. That is the intended, safe outcome.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  // familyId is not decoration: revoking a family on replay looks up by it.
  @@index([familyId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Email verification for credentials signup.
//
// Same shape as PasswordResetToken with one deliberate difference: only the
// SHA-256 of the token is stored. A reset token in the clear is already a
// weakness in that table; there is no reason to reproduce it here, and hashing
// costs a single digest on a path that runs once per account.
//
// Four properties do the work:
//   HASHED     — a database read yields no usable verification link.
//   EXPIRING   — 24 hours, checked on every redemption.
//   SINGLE USE — the row is deleted the moment it is redeemed, so a link that
//                leaks from a mailbox later is inert.
//   ONE LIVE   — issuing purges any prior token for that user, so a resend
//                invalidates the previous email rather than leaving a fleet of
//                working links behind.
//
// Keyed on userId rather than email: the account is what gets verified, and an
// email change must not leave a token that verifies the new address using proof
// of the old one.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Item {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  images      String    @db.Text
  category    Category
  condition   Condition
  // The FINAL value: what the owner is asking, after any override they made.
  // This is the number every other surface reads. The owner may set it lower
  // than the suggestion freely, or higher up to ONE BRACKET above the
  // suggestion's bracket; anything above that is stored here as REQUESTED and
  // the listing sits in PENDING_REVIEW until an admin approves it (see
  // decideItemValue() in @/lib/valuation-server and the ItemStatus note).
  valueLeaves Int?

  // TRUE when the owner typed their own value rather than taking the
  // suggestion. Stored, not derived from valueLeaves != suggestedLeaves: an
  // owner can type the suggested number back in, and a category re-valuation
  // can move suggestedLeaves under a value the owner never touched. The admin
  // Listings page shows both numbers and this flag side by side.
  valueSetByUser Boolean @default(false)

  // The valuation model's own number, before the owner touched it. Stored
  // alongside the final value rather than instead of it so the divergence
  // between what the model said and what people listed at is MEASURABLE:
  //   SELECT AVG((valueLeaves - suggestedLeaves) / suggestedLeaves) FROM Item
  //   WHERE suggestedLeaves IS NOT NULL;
  // NULL means the listing predates the valuation system (see the 2026-08-25
  // migration) — it does not mean "no suggestion was made".
  suggestedLeaves Int?

  // Which path produced suggestedLeaves: "comparables" or "category_band",
  // exactly those strings. A plain VARCHAR and not an enum on purpose: the same
  // two literals go out on the wire, and a wire value generated from a DB enum
  // name is one that changes the day someone renames the enum. The writable set
  // is closed in code by VALUATION_SOURCES in @/lib/valuation.
  //
  // This column exists to answer one question with a query instead of a guess:
  // how many listings were valued from real Baylo trade history rather than the
  // fallback band table.
  valuationSource String? @db.VarChar(32)

  // Re-valuations already spent on this listing. Capped at MAX_REVALUATIONS.
  // The model is deterministic, so re-running it on unchanged inputs returns
  // the identical number; the only way a repeat request moves the suggestion is
  // if the category or condition was edited. One correction is allowed, then
  // the listing is done shopping for a friendlier number.
  revaluationCount Int @default(0)

  status ItemStatus @default(AVAILABLE)

  // Free text only: what the owner wants in return. This column used to double
  // as a JSON envelope carrying the pickup coordinates, which is how a home
  // address ended up being served to unauthenticated callers — a field named
  // "wanted items" is not somewhere anyone thinks to look for location data.
  // Pickup now lives in the three explicit columns below and is filtered by
  // resolvePickup() in @/lib/item-visibility on every read path.
  wantedItems String? @db.Text

  // Exact pickup point. NEVER serialise these straight onto a response: full
  // precision plus pickupAddress identifies a seller's home. Only the owner and
  // an accepted trade counterparty may see them; everyone else gets the
  // 2-decimal-place (~1 km) rounding that resolvePickup() applies.
  pickupLat     Float?
  pickupLng     Float?
  pickupAddress String? @db.Text

  // Moderator takedown. NULL means "not hidden by us"; non-null is the moment a
  // moderator removed it, and the who/why lives in the AdminAction row written
  // in the same transaction.
  //
  // A SEPARATE COLUMN AND NOT `status = REMOVED`, for one concrete reason: the
  // owner can already move their own item in and out of REMOVED/OWNED/AVAILABLE
  // -- POST /api/items/[id]/relist does exactly that -- so a takedown expressed
  // as a status would be undoable by the person it was aimed at. Every read path
  // filters on `moderationHiddenAt: null` in the WHERE clause, and relist
  // refuses while it is set.
  moderationHiddenAt DateTime?

  // Set when a value review is refused (status VALUE_REJECTED); cleared when
  // the listing leaves that status. The code, never the moderator's note --
  // the note lives in the AdminAction row. Nullable so main can read every
  // row before the feature lands (the schema-first rule, see SETUP.md).
  valueRejectionReason ValueRejectionReason?

  appeals ListingAppeal[]

  /// THE LEAD PHOTO'S dHash, AND ONLY THE LEAD PHOTO'S.
  ///
  /// Kept because the web listing wizard round-trips it through its edit mode
  /// and GET /api/v1/items/[id] returns it. It is NO LONGER what the duplicate
  /// check reads: that is ItemImageHash, which holds one row per photo. A
  /// listing's five photos were five ways to re-post someone else's item and
  /// only the first was ever compared.
  ///
  /// Write paths keep this in step with position 0 of ItemImageHash. If the two
  /// ever disagree, the TABLE is right.
  imageHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  offeredIn   TradeRequest[] @relation("OfferedItem")
  requestedIn TradeRequest[] @relation("RequestedItem")
  likes       PostLike[]     @relation("ItemPostLikes")
  comments    PostComment[]  @relation("ItemPostComments")
  offers      Offer[]        @relation("ItemOffers")

  /// Public meetup points this listing is offered at. ZERO IS NORMAL and means
  /// delivery-only or arrange-it-in-chat -- it is not an incomplete listing.
  /// Capped at MAX_ITEM_HUBS by the write paths; see @/lib/safe-zones.
  safeZones ItemSafeZone[]

  /// One dHash per photo. See ItemImageHash.
  imageHashes ItemImageHash[]

  // Both created by raw CREATE INDEX in the pre-baseline chain and never
  // declared here. Declaring them keeps the squashed baseline faithful.
  // "hidden takedowns, and the AVAILABLE feed that must exclude them".
  @@index([status, moderationHiddenAt])
  // The comparables lookup: same source, same category.
  @@index([valuationSource, category])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
}

/// ONE PERCEPTUAL HASH PER PHOTO, WHICH IS THE POOL THE DUPLICATE CHECK SCANS.
///
/// Item.imageHash is a single column, so a listing with five photos put exactly
/// one image into the duplicate pool. Re-posting somebody else's photo #3 was
/// never caught, and anyone who noticed had an unlimited bypass that needed no
/// tooling -- just a second photo.
///
/// `position` is the index into the listing's own `images` JSON array, so a
/// match knows WHICH photo it hit. Stage 2 sends Claude that photo rather than
/// the listing's first one; comparing a matched photo #3 against a stranger's
/// photo #1 would have Claude correctly answer "different" and overturn a true
/// positive.
model ItemImageHash {
  itemId   String
  position Int
  hash     String @db.VarChar(64)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// The PK's leading column is the only lookup by item anyone needs, and the
  /// pair enforces one hash per photo slot. The duplicate scan reads the whole
  /// table and compares in JS -- Hamming distance is not something an index can
  /// answer -- so there is deliberately no index on `hash`: it would be paid for
  /// on every write and used by nothing.
  @@id([itemId, position])
}

model TradeRequest {
  id        String      @id @default(cuid())
  status    TradeStatus @default(PENDING)
  message   String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  hiddenBySender   Boolean @default(false)
  hiddenByReceiver Boolean @default(false)

  /// WHICH Safe-Zone hub the parties say they met at. NULL means they did not
  /// claim one, and it is what the SAFEZONE_MEETUP reward keys off -- the
  /// reward condition is `safeZoneHubId IS NOT NULL`, not a separate flag.
  ///
  /// THIS IS PRE-COMMITTED SELF-ATTESTATION. IT IS NOT VERIFICATION, and the
  /// distinction is worth stating plainly rather than letting a foreign key
  /// imply proof:
  ///
  ///   What it does NOT establish: that these two people were ever at this
  ///   place. Nothing here observes the world. A participant who wants the 10
  ///   Leaves without going to Parkmall types the same request as one who went.
  ///
  ///   What it DOES establish: the claim was pre-committed and is mutual. The
  ///   hub must be one that BOTH traded listings were already publicly offered
  ///   at, which means both owners independently named it before this trade
  ///   existed, and the counterparty could see it at offer time. A lie now has
  ///   to be arranged in advance, by two people, in public, rather than ticked
  ///   at the end by one of them.
  ///
  ///   What replaced what: this used to be `safeZoneMeetup Boolean`, set by
  ///   either party sending `safeZone: true` at confirmation. That was
  ///   unfalsifiable and uncorrelated with anything -- an unauditable boolean
  ///   attached to a currency award.
  ///
  /// GPS proximity was considered and deliberately rejected. A client-reported
  /// coordinate is spoofable from a developer-options toggle, so without device
  /// attestation it is a more elaborate checkbox; and every seeded hub landmark
  /// is indoors or under a roof, where GPS routinely drifts 50-200 m, so an
  /// honest-user-safe radius in a dense commercial strip would cover several
  /// other hubs anyway. The honest position is the one written above.
  safeZoneHubId String?
  safeZoneHub   SafeZoneHub? @relation("MeetupClaim", fields: [safeZoneHubId], references: [id], onDelete: Restrict)

  /// ── THE MEETUP PLAN ───────────────────────────────────────────────────────
  ///
  /// Where and when the parties have ARRANGED to meet. This is a different fact
  /// from `safeZoneHubId` directly above it, and the two must never be merged:
  ///
  ///   `safeZoneHubId`  is the CLAIM. "We met here", asserted afterwards, at
  ///                    confirm/submit. It is what the SAFEZONE_MEETUP reward
  ///                    keys off -- the condition is literally
  ///                    `safeZoneHubId IS NOT NULL`.
  ///   `meetupHubId`    is the PLAN. "Let us meet here", asserted beforehand,
  ///                    by one party and agreed by the other. It awards nothing.
  ///
  /// WRITING A PLAN INTO THE CLAIM WOULD MINT 10 LEAVES FOR A MEETING THAT HAS
  /// NOT HAPPENED, and would do it at the moment somebody merely SUGGESTED a
  /// place. A plan is not evidence; only the pair of typed codes is. The plan
  /// does become the DEFAULT for the claim at confirmation -- the parties should
  /// not be asked twice -- but it is copied across by the confirm route, after
  /// the codes match, and never read as the claim itself.
  ///
  /// THE FOUR COLUMNS MOVE TOGETHER. Three states, and nothing else is legal:
  ///
  ///   no plan    all four NULL
  ///   proposed   hub + at + proposedBySender set, agreedAt NULL
  ///   agreed     all four set
  ///
  /// The invariant is enforced in the meetup routes rather than by a CHECK
  /// constraint, which MariaDB 10.4 will parse and Prisma will not model. Every
  /// write of these columns goes through one of the two routes and each writes
  /// the whole group.
  meetupHubId String?
  meetupHub   SafeZoneHub? @relation("MeetupPlan", fields: [meetupHubId], references: [id], onDelete: Restrict)

  /// When they have arranged to meet. A real timestamp rather than free text:
  /// two people agreeing to "sat afternoon ha" have not agreed on anything a
  /// reminder, a sort, or the other person's calendar can act on.
  meetupAt DateTime?

  /// "the bench outside, I'll have the blue bag". The detail a hub id and a
  /// timestamp cannot carry. Optional, short, and never load-bearing.
  meetupNote String? @db.VarChar(200)

  /// WHICH SIDE proposed the standing plan -- deliberately a side and not a
  /// userId. A `meetupProposedById` FK can point at somebody who is not in this
  /// trade, and then "you cannot accept your own proposal" is guarding against
  /// a state the column let us write in the first place. A boolean against
  /// `senderId`/`receiverId` cannot be wrong, and rendering "Renz suggested"
  /// only ever needed to know which of the two names to use.
  meetupProposedBySender Boolean?

  /// Set when the OTHER side agrees. NULL with a hub set means one proposal is
  /// standing and unanswered. A counter-proposal overwrites the plan and clears
  /// this, which is why there is no separate decline: countering IS declining,
  /// and it leaves something on the table instead of a hole.
  meetupAgreedAt DateTime?

  senderId   String
  sender     User   @relation("SentRequests", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedRequests", fields: [receiverId], references: [id])

  offeredItemId   String
  offeredItem     Item   @relation("OfferedItem", fields: [offeredItemId], references: [id])
  requestedItemId String
  requestedItem   Item   @relation("RequestedItem", fields: [requestedItemId], references: [id])

  // Leaves moving from sender to receiver as part of this trade. NULL means
  // none — the same thing the `?? 0` at each old recovery site meant.
  //
  // This is recorded ON the trade rather than recovered from the Offer that
  // produced it. The old correlation (senderId + postId + status ACCEPTED) is
  // not unique: five trades match more than one accepted offer, one matches
  // eight, and one sender/post pair holds two different amounts (100 and 200).
  // Settlement resolved that with findFirst() and no orderBy, so the amount it
  // debited was whichever row the optimiser returned. Settlement is the one
  // code path that moves currency; it does not get to guess.
  offeredLeaves Int?

  /**
   * The bridging fee this trade carries, copied from the Offer at accept for
   * exactly the reason `offeredLeaves` is: settlement and cancellation read
   * the trade and never re-find the offer. NULL means same-bracket, no fee.
   * The Leaves are already out of the payer's balance by the time a trade
   * exists; completion pays them to the OTHER party, REJECTED/CANCELLED
   * returns them to the payer. See Offer.bridgeFeeLeaves.
   */
  bridgeFeeLeaves Int?

  /**
   * WHICH SIDE PAID IT. True when the sender (the proposer) did, false when
   * the receiver did, NULL when there is no fee.
   *
   * NOT DERIVED, and that is the point. The payer is the side handing over the
   * lower-bracket item, which is a fact about the two items AT THE MOMENT THE
   * OFFER WAS AGREED -- and a value can be edited afterwards, an item can be
   * re-valued, an admin can approve a review. Re-deriving it at completion
   * would mean the Leaves could be paid to the wrong person because somebody
   * edited a listing in between. Settlement and cancellation read this column
   * and nothing else.
   *
   * A boolean against `senderId` rather than a `bridgeFeePayerId` FK, the same
   * argument `meetupProposedBySender` makes: an id column can point at
   * somebody who is not in this trade, and then every reader has to guard
   * against a state the column let us write.
   */
  bridgeFeePaidBySender Boolean?

  messages              Message[]
  reviews               Review[]
  swapConfirmationCodes SwapConfirmationCode[]
  deferredContracts     DeferredContract[]

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([senderId])
  @@index([receiverId])
  @@index([offeredItemId])
  @@index([requestedItemId])
  @@index([safeZoneHubId])
  @@index([meetupHubId])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  systemEventKey String? @unique
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  tradeId String?
  trade   TradeRequest? @relation(fields: [tradeId], references: [id])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([senderId])
  @@index([receiverId])
  @@index([tradeId])
}

/**
 * Hides one conversation for one viewer without touching its messages.
 *
 * The direction is intentional: A can hide A/B while B still sees the same
 * history. A new message clears the sender's hide row and makes the thread
 * visible again to that sender; the recipient's hide row is cleared when they
 * send their next message.
 */
model ConversationHide {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ConversationHidesByViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  partnerId String
  partner   User     @relation("ConversationHidesByPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  hiddenAt  DateTime @default(now())

  @@unique([viewerId, partnerId])
  @@index([partnerId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  // Structured navigation target, kept SEPARATE from `type`.
  //
  // `type` is the EVENT that happened; entityType/entityId are WHAT TO OPEN.
  // They do not map one-to-one — TRADE_ACCEPTED and NEW_MESSAGE both point at a
  // chat partner, while TRADE_COMPLETED points at a list with no id at all.
  // Collapsing the two is the mismatch that bites later.
  //
  // entityType is a plain string, not an enum: the set of navigable targets
  // grows with the mobile client and each addition would otherwise cost a
  // schema migration for what is just a routing token.
  //
  // TWO VOCABULARIES LIVE IN THIS COLUMN. That is deliberate, and knowing which
  // one a row uses is a matter of when it was written.
  //
  //   v1 and later (what new writes use) — the fine-grained set:
  //     "conversation"   entityId = the other participant's userId
  //     "trade"          entityId = the tradeId
  //     "review"         entityId = the reviewId
  //     "follow_request" entityId = null
  //     "report"         entityId = the reportId (REPORT_RESOLVED)
  //
  //   pre-v1 (the migrated rows) — a coarse set the old `link` column could
  //   actually support:
  //     "user"   entityId = a userId, or null
  //     "trade"  entityId = ALWAYS null
  //
  // The distinction that matters is "conversation" vs "user": a notification
  // about a message opens a THREAD WITH someone, not their profile. The old
  // links could not express that difference, which is why the backfill could
  // not either.
  //
  // CAVEAT ON PRE-v1 ROWS. The backfill recovered only what the old `link`
  // encoded, and trade notifications encoded a chat partner. So rows written
  // before /api/v1 — TRADE_ACCEPTED in particular — carry ('user', <userId>)
  // rather than ('trade', <tradeId>). Deliberately not corrected: they are
  // already imperfect and they retire with the web user-side routes. Never read
  // a pre-v1 TRADE_* entityId as a trade id.
  //
  // `link` is still written and still read by the web admin. Unchanged.
  entityType String?
  entityId   String?

  userId  String
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
  @@index([actorId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  reviewerId String
  reviewer   User   @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User   @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  tradeId String
  trade   TradeRequest @relation(fields: [tradeId], references: [id])

  @@unique([tradeId, reviewerId])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([reviewerId])
  @@index([revieweeId])
}

// Task reward system: one row per completed task.
// One-time tasks use refId "" (MySQL treats NULLs as distinct in unique
// indexes, so an empty-string default is what enforces once-per-user);
// repeatable tasks (VERIFIED_SWAP, SAFEZONE_MEETUP) use refId = tradeId.
// The @@unique below is what makes every award idempotent — do not relax it.
model TaskCompletion {
  id        String   @id @default(cuid())
  task      TaskKind
  refId     String   @default("")
  leaves    Int
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, task, refId])
  @@index([userId])
}

enum TaskKind {
  VERIFY_ACCOUNT
  COMPLETE_PROFILE
  FIRST_LISTING
  // LEGACY. Paid 20 Leaves per completed trade until 16 Sep 2026, when the
  // per-trade payout became TRADE_REWARD (2 x bracket, see @/lib/trade-rules).
  // The value stays for the rows already written; nothing awards it now.
  VERIFIED_SWAP
  SAFEZONE_MEETUP
  // One-time: the first trade this account ever completed. What replaced the
  // per-trade VERIFIED_SWAP as a task -- a milestone, not a faucet.
  FIRST_TRADE
}

// ── Weekly quests (23 Sep 2026) ──────────────────────────────────────────────
//
// Three quests, one per QuestTier, assigned to every user for a fixed
// calendar week (`weekStart`, Monday 00:00 UTC) and reconciled against real
// DB state the same way TaskCompletion is -- see reconcileQuests() in
// @/lib/quests. Every quest is an existing, already-tracked platform action
// (send an offer, list an item, complete a trade); none of it is a new
// engagement metric like time-in-app, which is deliberate -- the manuscript
// frames Baylo's Point System as a reward system rather than gamification,
// and a metric with no real-world action behind it would contradict that.
//
// ONE ROW PER (user, week, tier), not per quest: the tier is what is
// guaranteed to exist every week, and `quest` is which pool entry filled it.
// `rewardLeaves` is snapshotted at assignment time so a later change to
// QUEST_REWARDS never rewrites what a past week actually paid.
model QuestAssignment {
  id           String    @id @default(cuid())
  weekStart    DateTime
  tier         QuestTier
  quest        QuestKind
  rewardLeaves Int
  /// Non-null means paid -- the same "row's existence/non-null column is the
  /// fact" shape as UserAchievement.unlockedAt. Credits Leaves exactly once;
  /// see the claim guard in completeQuest() in @/lib/quests.
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, tier])
  @@index([userId, weekStart])
}

enum QuestTier {
  EASY
  MEDIUM
  HARD
}

enum QuestKind {
  // ── EASY pool ──
  SEND_OFFER
  FOLLOW_TRADER
  LEAVE_REVIEW
  // ── MEDIUM pool ──
  LIST_ITEM
  RECEIVE_OFFER
  // ── HARD pool ──
  COMPLETE_TRADE
  COMPLETE_BRIDGE_TRADE
  COMPLETE_SAFEZONE_TRADE
}

model SwapConfirmationCode {
  id       String       @id @default(cuid())
  tradeId  String
  trade    TradeRequest @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  used     Boolean      @default(false)

  /**
   * The same code, sealed so its OWNER can be shown it. AES-256-GCM, keyed from
   * SWAP_CODE_KEY in the environment and never from anything in this database.
   *
   * ADDITIVE, NOT A REPLACEMENT. `codeHash` above is still what confirm/submit
   * verifies against and nothing about the guess budget changes; this column is
   * read on exactly one path -- the owner asking confirm/status for their own
   * code -- so a fault here cannot make a wrong code verify.
   *
   * NULL is a first-class value. A deployment with no key seals nothing, the
   * status route answers `code: null`, and the client points the reader at the
   * email exactly as it does today. Rotating the key leaves old rows unopenable
   * and that is a fifteen-minute problem, not a data-loss one -- see the long
   * note in @/lib/swap-code-seal.
   *
   * The ciphertext is bound to (tradeId, userId) as GCM additional authenticated
   * data, so a value moved between rows by anyone with write access fails to
   * open rather than yielding one person's digits to another.
   */
  codeSealed String? @db.Text

  // Wrong guesses against THIS code. A 6-digit code is a 1-in-a-million secret
  // only while the number of guesses is bounded; unbounded, a trade participant
  // can grind their partner's code and complete a "verified in-person swap"
  // without ever meeting — which is exactly what the VERIFIED_SWAP and
  // SAFEZONE_MEETUP Leaf awards are paid for. At MAX_CODE_ATTEMPTS the code is
  // burned and both parties have to restart.
  attempts Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([tradeId, userId])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([userId])
}

