model Offer {
  id            String      @id @default(cuid())
  postId        String
  post          Item        @relation("ItemOffers", fields: [postId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("SentOffers", fields: [senderId], references: [id])
  receiverId    String
  receiver      User        @relation("ReceivedOffers", fields: [receiverId], references: [id])
  offeredItems  String      @db.Text
  /**
   * LEGACY. Leaves the sender added on top of their item, from before trading
   * became bracket-based (16 Sep 2026). New offers never carry one -- the
   * schema refuses the field -- and the column exists only so the offers and
   * trades that were already in flight settle the way they were agreed.
   * `availableLeaves()` still subtracts it for PENDING rows for that reason.
   */
  offeredLeaves Int?
  message       String?     @db.Text
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  /**
   * ── THE BRIDGE ────────────────────────────────────────────────────────────
   *
   * An offer is one item for one item, and the offered item is either in the
   * SAME bracket as the listing or exactly ONE below it. The second case is a
   * bridge, and it costs the proposer `bridgingFee(offeredBracket)` Leaves --
   * see @/lib/trade-rules for the formula, which is never written out here.
   *
   * `bridgeFeeLeaves` NULL means same-bracket, no fee. Non-null means the fee
   * was HELD when the offer was created: a BRIDGE_FEE_HOLD ledger row on the
   * proposer and the same amount off their balance, in the same transaction
   * as this row. It is released (BRIDGE_FEE_RELEASE) when the offer or the
   * trade it becomes dies, and paid to the receiver (BRIDGE_FEE_PAID) when the
   * trade completes. The trade carries its own copy, see TradeRequest.
   *
   * `offeredBracket` / `targetBracket` are SNAPSHOTS of the two brackets at
   * proposal, for the audit trail and for the accept-time re-check to name
   * what moved. They are not read as the rule -- the rule is re-derived from
   * `Item.valueLeaves` on every check.
   *
   * `consentAt` / `policyVersion` record the PAYER ticking "I agree to the
   * bridging fee and the trading policy". Required on a bridge, absent on a
   * same-bracket offer, and the version is TRADING_POLICY_VERSION at the time.
   *
   * WHICH SIDE consented, and therefore WHEN these are written, depends on the
   * direction: the proposer pays when they offer the lower item, so their
   * consent is recorded with the offer; the receiver pays when they are
   * offered the higher item, so theirs is recorded at accept, onto this same
   * row. `bridgeFeeLeaves` is the QUOTE from the moment the offer was made and
   * is set either way -- it is not evidence that anything has been held. What
   * is held is exactly: a proposer-pays offer that is still PENDING, and any
   * live trade. See @/lib/bridge-fee.
   */
  bridgeFeeLeaves Int?
  offeredBracket  Int?
  targetBracket   Int?
  consentAt       DateTime?
  policyVersion   String?   @db.VarChar(32)

  /**
   * LEGACY. Deferred Points Agreements were removed on 16 Sep 2026 -- the
   * bridging fee covers the whole gap now. The relation and the table stay so
   * the one FULFILLED contract and its ledger pair keep round-tripping through
   * backups; no code path writes a row any more.
   */
  contracts DeferredContract[]

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([postId])
  @@index([senderId])
  @@index([receiverId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  /**
   * The SENDER retracted it. Not the same act as DECLINED, which is the
   * receiver refusing, and the two must stay distinct: they are performed by
   * different people and they say different things about the sender.
   *
   * Terminal, like the other two. `availableLeaves()` counts only PENDING
   * offers, so withdrawing releases the sender's pledged Leaves the moment the
   * status moves — no separate release step, and nothing to get out of step.
   */
  WITHDRAWN
  /**
   * Nobody acted within the window. Not DECLINED and not WITHDRAWN: those are
   * things a person DID, and this is the absence of one. Collapsing it into
   * DECLINED would tell a sender, permanently, that they were refused by
   * somebody who never opened the message.
   *
   * The window is `OFFER_EXPIRY_DAYS` in @/lib/offers and is measured from
   * `createdAt` rather than stored per row — see the note there. Reached by a
   * lazy sweep on the read paths that measure a balance, because nothing on
   * this deployment runs on a schedule.
   */
  EXPIRED
}

enum LeafTxType {
  TRADE_SPEND
  TRADE_RECEIVE
  TASK_REWARD
  SIGNUP_GRANT
  // Deferred Points Agreement settlement. Always written as a PAIR in one
  // transaction -- CONTRACT_PAY on the debtor for -n, CONTRACT_COLLECT on the
  // creditor for +n -- so the pair nets to zero and
  // SUM(User.leaves) == SUM(LeafTransaction.amount) survives every payment.
  CONTRACT_PAY
  CONTRACT_COLLECT
  // ── Bracket trading (16 Sep 2026) ──
  //
  // The bridging fee, in three rows over the life of one offer. HOLD is a real
  // debit -- the Leaves leave User.leaves the moment the offer is made -- so
  // SUM(User.leaves) == SUM(amount) keeps holding at every step. While the
  // offer lives, the held amount is in ESCROW: on no user's balance, and the
  // negative HOLD row is the only trace of it. Exactly one of RELEASE (back to
  // the proposer) or PAID (to the receiver) closes it, and the three then net
  // to zero. See @/lib/bridge-fee.
  BRIDGE_FEE_HOLD
  BRIDGE_FEE_RELEASE
  BRIDGE_FEE_PAID
  // ISSUANCE. New Leaves entering the system when a trade completes,
  // 2 x the bracket of the item that user gave -- never its value. The one
  // formula is tradeReward() in @/lib/trade-rules. REVERSAL is the admin undo,
  // negative, and is the only thing that ever decrements lifetimeLeaves.
  TRADE_REWARD
  TRADE_REWARD_REVERSAL
  // The daily free-Leaves allowance for a live Premium or VIP subscriber --
  // 5 or 10 Leaves, once per UTC calendar day. See claimDailyTierGrant() in
  // @/lib/tier-grant, which is the only writer.
  TIER_DAILY_GRANT
  // A completed weekly quest -- 5/10/20 Leaves for Easy/Medium/Hard. See
  // completeQuest() in @/lib/quests, which is the only writer.
  QUEST_REWARD
}

// Each row is one atomic Leaf movement (credit or debit).
// Leaves are non-monetary. The legitimate sources of a row:
//   - a completed trade settlement, which always writes a matching
//     TRADE_SPEND / TRADE_RECEIVE pair and nets to zero across users (legacy
//     offeredLeaves only, since 16 Sep 2026);
//   - a TASK_REWARD, written in the same transaction that increments both
//     leaves and lifetimeLeaves, and rate-limited by WEEKLY_TASK_LEAF_CAP;
//   - a bridging fee HOLD / RELEASE / PAID triple, see LeafTxType;
//   - a TRADE_REWARD, issuance on completion, see LeafTxType.
//
// THE RECONCILIATION, in full, as scripts/lib/ledger-invariant.ts checks it:
//   SUM(User.leaves) == SUM(amount)                      every row, signed
//   SUM(User.leaves) + escrow == issuance                nothing minted outside
//     escrow   = -(HOLD + RELEASE + PAID)                the issuance types
//     issuance =  SIGNUP_GRANT + TASK_REWARD + TRADE_REWARD + TRADE_REWARD_REVERSAL
//   escrow == SUM(bridgeFeeLeaves on live offers/trades) the ledger agrees with
//                                                        the rows it points at
//
// The two timestamps answer different questions and must not be conflated:
//   createdAt — when THIS ROW was written. Never backdated. For a backfill this
//               is the moment the backfill ran.
//   eventAt   — when the qualifying action actually happened (the trade
//               settling, the listing being posted). Equals createdAt on the
//               live path; for a backfilled award it is the historical event.
//
// WEEKLY_TASK_LEAF_CAP windows on eventAt, so an award is judged against the
// week it was earned in rather than the week it happened to be processed in.
model LeafTransaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LeafTxType
  amount      Int // positive = credit, negative = debit (in Pasa Leaves)
  description String

  // Optional references to the trade/offer that caused this debit/credit
  offerId    String?
  tradeId    String?
  // The DeferredContract this row paid down, for CONTRACT_PAY / CONTRACT_COLLECT.
  // A plain column rather than a relation, matching offerId and tradeId above:
  // the ledger points at things, nothing points back at the ledger.
  contractId String?

  createdAt DateTime @default(now())
  eventAt   DateTime

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, eventAt])
}

// ── Deferred Points Agreement ────────────────────────────────────────────────
//
// Two items are unequal in value. The party receiving the more valuable one
// agrees to owe the difference in Leaves and to settle it by a deadline.
//
// WHAT THIS MODEL DELIBERATELY CANNOT EXPRESS: getting the item back. There is
// no reversal state, no repossession field, no return flag. The item physically
// changed hands at a meetup and the system has no mechanism that could recover
// it — a status called RETURNED would be a lie the database told about the
// world. Every consequence of a default here is reputational (tier demotion,
// a public count) or access-based (blocked from initiating trades).
//
// DEBT SURVIVES DEFAULT. `status = DEFAULTED` does not zero amountPaidLeaves or
// close the contract: the remainder stays owed and auto-payment keeps applying
// to it. If defaulting wiped the balance, defaulting would be the cheap way to
// pay, and the deadline would be a suggestion.
model DeferredContract {
  id String @id @default(cuid())

  /**
   * WHAT THIS PROMISE IS ATTACHED TO. Exactly one of these is set at creation;
   * after an offer is accepted BOTH are set.
   *
   * A DPA used to require an already-ACCEPTED TradeRequest, which meant the
   * promise could not exist at the moment it was actually made — someone
   * proposing "I'll settle 100 by 6 Oct" alongside an offer had nowhere to
   * record it until the other party said yes. That inverted the feature: the
   * promise is the thing being decided ON, so it has to be a row before the
   * decision, not after it.
   *
   * So a contract may now hang off an Offer. When the offer is accepted the
   * accept path fills in `tradeId` against the TradeRequest it creates and
   * KEEPS `offerId` — the offer is where this promise came from, and that
   * provenance is worth more than the nullability it costs.
   *
   * NOT ENFORCED BY THE DATABASE. "Exactly one at creation, at least one
   * always" is a CHECK constraint, which Prisma cannot express and MariaDB
   * 10.4 would not inherit through `prisma migrate` anyway. It is enforced in
   * `assertContractSubject()` and at both creation sites; a row with neither is
   * a bug, and `contractSubject()` throws rather than guessing.
   */
  tradeId String?
  trade   TradeRequest? @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  offerId String?
  offer   Offer?        @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // The debtor is always the PROPOSER. A contract is a promise to pay, and the
  // only person who can make it is the person who will owe it; the creditor's
  // half of the bargain is consent, which is what PENDING_ACCEPT is for.
  debtorId   String
  debtor     User   @relation("ContractDebtor", fields: [debtorId], references: [id], onDelete: Cascade)
  creditorId String
  creditor   User   @relation("ContractCreditor", fields: [creditorId], references: [id], onDelete: Cascade)

  /**
   * Principal. Never mutated after acceptance — payment moves amountPaidLeaves.
   */
  amountLeaves     Int
  /**
   * Paid so far. Two columns rather than a decrementing balance so that the
   * original size of the promise stays legible on a half-paid contract.
   */
  amountPaidLeaves Int @default(0)

  deadline DateTime
  status   ContractStatus @default(PENDING_ACCEPT)

  // Exactly one extension, and only if the creditor grants it. The request and
  // the grant are separate columns because they are separate acts by separate
  // people: a debtor asking is not a deadline moving.
  extensionUsed              Boolean   @default(false)
  extensionRequestedAt       DateTime?
  extensionRequestedDeadline DateTime?

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  fulfilledAt DateTime?
  // Stamped by the deadline sweep, and NEVER cleared — not even when a
  // defaulted contract is later paid off in full and moves to FULFILLED. This
  // column, not `status`, is what "past defaults" counts and what the tier
  // demotion is derived from. Paying late settles the debt, not the record.
  defaultedAt DateTime?

  // The debtor's exposure checks and the concurrency check both filter on
  // (debtorId, status); the creditor's list filters on (creditorId, status);
  // the lazy sweep filters on (status, deadline).
  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([status, deadline])
  @@index([tradeId])
  // The offer-accept path looks a contract up by offer, and so does withdraw.
  @@index([offerId])
}

enum ContractStatus {
  PENDING_ACCEPT
  ACTIVE
  FULFILLED
  DEFAULTED
  // Not in the original four. A creditor who refuses a proposal produces a row
  // that is neither fulfilled nor defaulted, and deleting it would erase the
  // one fact the preview screen exists to surface — that someone looked at this
  // debtor's numbers and said no. See the note in the change report.
  DECLINED
}

// ── Moderation: roles, reports, blocks, audit ────────────────────────────────
//
// Google Play's UGC policy requires in-app reporting and in-app blocking before
// a marketplace app passes review. That is why these four models exist now
// rather than later. It is not why they are shaped the way they are.

/**
 * Privilege. The current system is intentionally ADMIN-only.
 * MODERATOR and SUPER_ADMIN were removed from the live role model to keep the
 * permission model simple and avoid ambiguity: ordinary users are USER, and
 * staff access is ADMIN only.
 */
enum Role {
  USER
  ADMIN
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

/**
 * Why the reporter says the content is wrong.
 * SCREAMING_SNAKE in the database, matching every other enum here, and the wire
 * carries the lower-case forms ("prohibited_item", "scam_or_fraud") through an
 * explicit closed map in @/lib/moderation. That is the same call
 * Item.valuationSource documents and for the same reason: a wire value
 * generated from a database enum name changes the day somebody renames the
 * enum, and a mobile client has already shipped against the old spelling.
 */
enum ReportCategory {
  SPAM
  PROHIBITED_ITEM
  SCAM_OR_FRAUD
  HARASSMENT
  COUNTERFEIT
  OTHER
}

/**
 * OPEN and REVIEWING are both LIVE -- see Report.openKey. ACTIONED and
 * DISMISSED are both RESOLVED, and the difference between them is whether
 * anything happened to the target, which is exactly what the reporter is told.
 */
enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

/**
 * One user's claim that one piece of content breaks the rules.
 * The target is a (type, id) pair rather than three nullable foreign keys.
 * Nullable FKs would give the database a shape it can check -- a real
 * constraint that the listing exists -- and that is a genuine loss, taken
 * deliberately: a report must survive its target. A scam listing that gets
 * deleted, by its owner or by us, is precisely the report a moderator still
 * needs to read, and an FK with ON DELETE CASCADE would erase the evidence at
 * the moment it started mattering. The route validates that the target exists
 * at report time; nothing keeps it alive afterwards, and nothing needs to.
 */
model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String
  category   ReportCategory
  /**
   * Free text from the reporter. Capped at MAX_REPORT_NOTES in @/lib/moderation.
   */
  notes      String?          @db.Text

  status ReportStatus @default(OPEN)

  /**
   * "One OPEN report per reporter per target" as a database constraint.
   * MySQL treats NULLs as DISTINCT in a unique index -- the same property
   * TaskCompletion.refId leans on, inverted. This column holds the literal
   * "live" while the report is OPEN or REVIEWING and NULL once it is ACTIONED
   * or DISMISSED, so the @@unique below permits exactly one live report per
   * (reporter, target) and any number of resolved ones. Without it a reporter
   * who was told "no" could never report that target again, which is wrong: a
   * seller who cleans up a listing and re-posts the same violation next month
   * has committed a new violation.
   * WRITTEN BY THE APPLICATION, in the same statement that sets `status`, and
   * never on its own -- see resolveReport() in @/lib/moderation, which is the
   * only code that moves either column. It was going to be a STORED generated
   * column, which cannot drift at all; MariaDB 10.4.32 hangs the entire server
   * on an UPDATE to a table with a stored generated column inside a unique
   * index (a leaked buf0flu latch that takes DICT_SYS down with it), so that
   * idea is recorded here as tried and rejected rather than left for the next
   * person to rediscover it the same way.
   */
  openKey String? @db.VarChar(4)

  /**
   * Who closed it. SetNull rather than Cascade: the report outlives the staff account.
   */
  resolvedById   String?
  resolvedBy     User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  /**
   * What the reporter is told. Goes verbatim into the REPORT_RESOLVED notification.
   */
  resolutionNote String?   @db.Text

  createdAt DateTime @default(now())

  actions AdminAction[]

  @@unique([reporterId, targetType, targetId, openKey])
  // The queue: filtered by status, newest first.
  @@index([status, createdAt])
  // "everything ever filed against this listing" -- the report detail screen.
  @@index([targetType, targetId])
  @@index([reporterId])
  // See the note on AdminAction.reportId: declared so the FK's implicit index
  // does not become the schema of record under a different name.
  @@index([resolvedById])
}

/**
 * A one-way wall. blocker stops seeing, and stops being reachable by, blocked.
 * ONE ROW, NOT TWO. A block is asymmetric as an act -- only the blocker chose it
 * and only the blocker can undo it -- and symmetric in effect, because every
 * enforcement point queries BOTH directions (blocksMade none + blocksReceived
 * none). Writing a mirror row would make "who blocked whom" unrecoverable,
 * which is the one fact a moderator reading a harassment report needs.
 * WHAT A BLOCK DOES NOT DO: cancel a trade, void a DeferredContract, or delete
 * a message. See the note above enforceNotBlocked() in @/lib/blocking -- a
 * block that could rewind an obligation would be a debtor's escape hatch from
 * a creditor, and the block button is not a contract-reversal button.
 */
model Block {
  id String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  // Every feed query asks "has anyone blocked me?", which reads this side.
  @@index([blockedId])
}

/// Which government ID was presented.
///
/// STUDENT IDs ARE ABSENT AND THAT IS THE POINT OF THE LIST. They are held
/// disproportionately by minors -- this platform is 18+, see User.dateOfBirth --
/// and they are the easiest document here to forge convincingly, because every
/// school prints its own and no reviewer can know what any given one looks
/// like. The seven below are all issued by a national agency against a
/// registry, which is what makes "does this look right?" a question a
/// non-expert reviewer can actually answer.
///
/// SCREAMING_SNAKE here, lower_snake on the wire through the closed map in
/// @/lib/id-verification -- the same call ReportCategory and SafeZoneType
/// document, for the same reason.
enum IdType {
  NATIONAL_ID
  DRIVERS_LICENCE
  PASSPORT
  UMID
  PHILHEALTH
  POSTAL_ID
  VOTERS_ID
}

enum IdVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a submission was refused.
///
/// A CLOSED LIST AND NOT FREE TEXT, because the whole value of a rejection is
/// that the person can fix it and try again. "Rejected" tells them nothing;
/// "the photo is too blurry to read" tells them to retake it in better light.
/// Free text would let a tired reviewer type "no" at 1am and burn one of the
/// three attempts a real user gets.
enum IdRejectionReason {
  BLURRY_PHOTO
  NAME_MISMATCH
  EXPIRED_ID
  WRONG_DOCUMENT_TYPE
  NOT_GOVERNMENT_ID
}

/**
 * One submitted government ID, and what was decided about it.
 * THE RETENTION RULE IS THE DESIGN OF THIS TABLE, not a policy written beside
 * it. This is government ID data under RA 10173, and the shape below is what
 * makes "we do not keep a folder of scanned IDs" a structural fact rather than
 * a promise:
 * the ID NUMBER  is only ever stored as a SHA-256 digest. The plaintext
 * exists in the request body and in nothing else -- not a
 * column, not a log line, not the admin queue.
 * the IMAGE      lives in a private Cloudinary folder for as long as the row
 * is PENDING, and is destroyed when a decision is made.
 * Approve or reject; the image goes either way.
 * what SURVIVES  the digest, the ID type, the outcome, who decided it and
 * when. Enough to audit a decision and enough to enforce one
 * ID per account, and nothing else.
 * A row is never deleted by a decision -- only by the deletion of the account
 * it belongs to, which is what frees the ID for re-use. See deleteAccount().
 */
model IdVerification {
  id String @id @default(cuid())

  userId String
  user   User   @relation("IdVerificationSubject", fields: [userId], references: [id], onDelete: Cascade)

  idType IdType

  /**
   * SHA-256 of the normalised ID number. NEVER THE NUMBER.
   * Normalisation (case, spaces, dashes) happens in @/lib/id-verification and
   * has to, or "S01-2345-678" and "s012345678" are two different people to this
   * column and the same person to a reviewer.
   * SHA-256 and not bcrypt, matching EmailVerificationToken.tokenHash and for a
   * related reason: this digest is looked up, not verified against a candidate.
   * The uniqueness check is a unique-index hit on a digest computed from the
   * submitted number, which a work factor would make impossible. The trade-off
   * is honest and worth naming: an ID number is low-entropy enough to be
   * brute-forced from a digest by anyone holding this table, so the digest is a
   * defence against casual reading and against the number leaking into a
   * backup, NOT against a determined attacker with the database. Storing the
   * number itself would be strictly worse in every one of those cases.
   */
  idNumberHash String @db.VarChar(64)

  /**
   * "One government ID, one account" as a database constraint.
   * The same trick as Report.openKey, and the same reason it cannot be a
   * generated column. This holds a COPY of idNumberHash while the row is
   * PENDING or APPROVED, and NULL once it is REJECTED. MySQL treats NULLs as
   * distinct in a unique index, so the @@unique below permits exactly one live
   * claim per ID number and any number of rejected ones.
   * WHICH IS THE WHOLE RULE FROM THE SPEC, expressed once:
   * REJECTED  frees the ID -- a real person whose photo was blurry must be
   * able to send the same ID again, and so must a second household
   * member if the first submission was a mistake.
   * APPROVED  does not. Otherwise a suspended user creates a new account and
   * re-presents the same ID, and the suspension means nothing.
   * PENDING   does not either. Two accounts racing the same ID through the
   * queue must not both be able to win.
   * DELETED   frees it, by the row being removed with the account.
   * WRITTEN BY THE APPLICATION, in the same statement that sets `status`, and
   * never on its own. MariaDB 10.4.32 hangs the entire server on an UPDATE to a
   * table with a STORED generated column inside a unique index; see the note on
   * Report.openKey, which is where that was found out.
   */
  claimKey String? @db.VarChar(64)

  status          IdVerificationStatus @default(PENDING)
  rejectionReason IdRejectionReason?

  /**
   * Who decided. SetNull: the decision outlives the staff account that made it.
   */
  reviewedById String?
  reviewedBy   User?     @relation("IdVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  submittedAt DateTime @default(now())

  /**
   * Which attempt this was: 1, 2 or 3.
   * A SNAPSHOT, NOT THE ENFORCEMENT. The cap is enforced by counting this
   * user's rows at submission time, because a stored counter and the rows it
   * counts are two things that can disagree -- and the direction they disagree
   * in here decides whether somebody gets a fourth try at a document they have
   * already been refused three times for. This column is what the reviewer and
   * the user read ("attempt 2 of 3"); the COUNT(*) is what refuses the fourth.
   */
  attemptCount Int

  /**
   * The uploaded photo, while it exists. NULL is the steady state.
   * Both columns are populated only between submission and decision, and they
   * are cleared on different schedules ON PURPOSE:
   * imageUrl       nulled inside the decision transaction. Once a decision is
   * made nothing may render this image again, and that must be
   * true the instant the decision commits -- it cannot wait on
   * a network call to Cloudinary.
   * imagePublicId  nulled only once Cloudinary confirms the destroy. It is
   * the delete key, so nulling it before the file is gone
   * would strand the file with nothing left pointing at it.
   * A decided row with a non-null imagePublicId is therefore exactly the set of
   * images that still need destroying, which is what the retry sweep queries.
   * See sweepUndeletedIdImages() in @/lib/id-verification.
   */
  imageUrl      String? @db.Text
  imagePublicId String? @db.VarChar(255)

  /**
   * When Cloudinary confirmed the destroy.
   */
  imageDeletedAt      DateTime?
  /**
   * When a destroy last failed. Non-null with imagePublicId non-null = retry me.
   */
  imageDeleteFailedAt DateTime?

  createdAt DateTime @default(now())

  // The live claim on an ID number. See claimKey.
  @@unique([claimKey])
  // "this user's submissions, newest first" -- the status screen and the cap.
  @@index([userId, submittedAt])
  // The queue: PENDING, oldest first.
  @@index([status, submittedAt])
  // The retry sweep: decided rows whose image is still up there.
  @@index([status, imagePublicId])

  // FK-backing indexes. MySQL/InnoDB created these implicitly for every
  // foreign key; Postgres does not, and neither does Prisma on Postgres.
  // Declared so the migration to Postgres keeps every index the live
  // MySQL database had (see the 2026-09-15 baseline).
  @@index([reviewedById])
}

enum AdminActionKind {
  REPORT_REVIEWING
  REPORT_DISMISSED
  REPORT_ACTIONED
  LISTING_HIDDEN
  LISTING_UNHIDDEN
  USER_SUSPENDED
  USER_UNSUSPENDED
  HUB_CREATED
  HUB_UPDATED
  HUB_DEACTIVATED
  HUB_REACTIVATED
  ID_VERIFICATION_APPROVED
  ID_VERIFICATION_REJECTED
  ROLE_CHANGED
  /**
   * An offer of the recipient's own aged out unanswered. Sent to the SENDER
   * only — the receiver is the one who did not reply, and telling them so is a
   * reproach rather than information. It carries the released Leaves in its
   * message because that is the part the sender can act on.
   */
  OFFER_EXPIRED
  // ── Bracket trading (16 Sep 2026) ──
  // A value review decided, either way. `detail` carries both numbers.
  LISTING_VALUE_APPROVED
  LISTING_VALUE_REJECTED
  // The TRADE_REWARD on a completed trade taken back from both parties. The
  // reward ONLY -- the bridging fee stays with the receiver, because the
  // items changed hands in person and nothing here can undo that.
  TRADE_REWARD_REVERSED
  // An admin cancelled a trade on the parties' behalf (test data, a dispute).
  TRADE_CANCELLED
  // ── Listing appeals (18 Sep 2026) ──
  // An owner's appeal against a value rejection or a takedown, decided.
  // `detail` carries both values, the appealed AdminAction's id, and
  // `sameReviewer: true` when the decider is the one who rejected it.
  // OPENING an appeal writes no row here: the actor of an AdminAction is
  // staff, and the ListingAppeal row itself is the immutable record of the
  // owner's step.
  LISTING_APPEAL_UPHELD
  LISTING_APPEAL_OVERTURNED
  // ── Achievements (admin surface) ──
  // An admin created, edited, activated or deactivated an achievement
  // definition. `detail` carries the prior/new field values. Deactivating
  // rather than deleting is the rule: a UserAchievement row points at this
  // definition, and deleting it would take every earned copy with it.
  ACHIEVEMENT_CREATED
  ACHIEVEMENT_UPDATED
  ACHIEVEMENT_DEACTIVATED
  ACHIEVEMENT_REACTIVATED
}

enum AdminTargetType {
  REPORT
  LISTING
  USER
  HUB
  ID_VERIFICATION
  TRADE
  LISTING_APPEAL
  ACHIEVEMENT
}

/**
 * The audit trail. Who did what, when, and why.
 * Moderation without an audit row is indistinguishable from abuse: a suspended
 * user, a hidden listing and a dismissed report all look the same whether a
 * moderator followed the policy or settled a grudge, and the only difference
 * that can ever be recovered is the one that was written down at the time.
 * `reason` is NOT NULL AND NOT DEFAULTED. Every route that writes one of these
 * requires the moderator to type it. An optional reason is a reason nobody
 * fills in.
 * `actorId` has no onDelete, which on MySQL means RESTRICT: the database
 * refuses to delete a staff account that has moderated anything. Deleting a
 * moderator must not vacuum up the record of what they did.
 */
model AdminAction {
  id String @id @default(cuid())

  actorId String
  actor   User   @relation("AdminActor", fields: [actorId], references: [id])

  action     AdminActionKind
  targetType AdminTargetType
  targetId   String

  /**
   * The report this action answers, when there is one. Bulk cleanup has none.
   */
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  reason String  @db.Text
  /**
   * JSON snapshot of what changed -- prior item status, prior suspension dates,
   * the listing title as it read at takedown. A plain Text column and not a
   * relation, matching LeafTransaction.tradeId: the audit points at things,
   * nothing points back at the audit.
   */
  detail String? @db.Text

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  // Present in the database since the moderation migration; declared here so a
  // baseline built from this schema reproduces it. Without the declaration MySQL
  // still indexes reportId to satisfy the foreign key, but names it
  // AdminAction_reportId_fkey -- same coverage, different name, permanent drift.
  @@index([reportId])
}

// -- Safe-Zone Hubs ----------------------------------------------------------

/// What kind of public place this is. The type drives nothing but display and
/// filtering today; it exists so "meet at a police station" and "meet at a
/// mall" are distinguishable to a user deciding where they are comfortable
/// going, and to us when we look at which kinds of place people actually pick.
///
/// SCREAMING_SNAKE here, lower_snake on the wire through the closed map in
/// @/lib/safe-zones -- the same call Item.valuationSource and ReportCategory
/// document, and for the same reason: a wire value generated from a database
/// enum name changes the day somebody renames the enum, and a shipped mobile
/// client has already parsed the old spelling.
// ─────────────────────────────────────────────────────────────────────────────
// ─────────────────────────────
// ACHIEVEMENTS -- MODELLED HERE AS OF 18 Sep 2026.
//
// These were pushed straight to the live database by an earlier pass (they had
// rows and appeared in no migration in this repository). They are modelled here
// now so `prisma migrate diff --from-config-datasource` stops proposing to DROP
// them every time it runs -- which it did, and which every hand-authored
// migration.sql had to strip out (20260918000000_value_rejection_appeals did).
// The models below match the live tables, plus THREE ADDITIONS this feature
// needs and the live tables did not have:
//
//   imageUrl         the uploaded badge art. `icon` stays as an emoji/text
//                    FALLBACK so badges created before an image was uploaded
//                    still render; a badge with an imageUrl shows the image.
//   homeDisplayOrder the single "featured" slot on the home feed. The display
//                    route already probes information_schema for this column,
//                    so the code was written half-expecting it; it is real now.
//   sortOrder        admin-controlled ordering for the achievements shelf.
//
// The accompanying migration is written to be ADDITIVE: it creates the tables
// if absent and adds the new columns if absent, and NEVER drops anything. See
// the header of that migration.sql for why that is the only safe shape here.
// ─────────────────────────────────────────────────────────────────────────────

enum ListingAppealKind {
  /** Against a LISTING_VALUE_REJECTED decision. Overturn publishes at the requested value. */
  VALUE_REJECTION
  /** Against a LISTING_HIDDEN takedown. Overturn clears moderationHiddenAt. */
  MODERATION_HIDE
}

enum ListingAppealStatus {
  OPEN
  UPHELD
  OVERTURNED
  /**
   * The owner deleted the listing while the appeal was open. Closed without
   * an admin decision -- it is their own listing -- and kept, not deleted,
   * so the queue's history and the audit rows it points at still make sense.
   * `decidedById` is null on these; `decisionReason` says what happened.
   */
  WITHDRAWN
}

/**
 * One owner's appeal against one moderation decision on one listing.
 *
 * ONE APPEAL PER DECISION, AND THE DECISION IS AN AUDIT ROW. `actionId` is
 * the id of the AdminAction being appealed (a LISTING_VALUE_REJECTED or a
 * LISTING_HIDDEN row) and it is UNIQUE here: a rejection can be appealed
 * once, an upheld appeal cannot be re-opened, and a fresh rejection after the
 * owner edits is a fresh decision with a fresh right of appeal. A plain
 * string and not a relation, matching Item -> AdminAction: the audit points
 * at things, nothing points back at the audit.
 *
 * While an appeal is OPEN the listing's visibility does not change -- it is
 * still VALUE_REJECTED or still hidden. Nothing about filing one is a
 * publish. Deleting the listing closes the appeal as WITHDRAWN.
 *
 * `message` is the owner's own words, capped at 300 characters. It is never
 * edited; a second thought is a second appeal, which the unique index refuses.
 *
 * `decidedById` is SetNull so a staff account can be removed without losing
 * the record; the AdminAction written at decision time keeps the name.
 */
model ListingAppeal {
  id String @id @default(cuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("ListingAppealOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  kind   ListingAppealKind
  status ListingAppealStatus @default(OPEN)

  message String @db.VarChar(300)

  /** The AdminAction this answers. Unique: one appeal per decision. */
  actionId String @unique

  decidedById    String?
  decidedBy      User?     @relation("ListingAppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionReason String?   @db.Text

  createdAt DateTime @default(now())

  // Oldest first is the queue's order; the owner's list and the listing's
  // history are the other two reads.
  @@index([status, createdAt])
  @@index([itemId])
  @@index([ownerId])
  @@index([decidedById])
}

enum SafeZoneType {
  MALL
  BARANGAY_HALL
  POLICE_STATION
  PUBLIC_PLAZA
  TRANSPORT_HUB
}

/// A curated public meetup point.
///
/// THIS MODEL EXISTS INSTEAD OF PLOTTING SELLERS ON A MAP. The alternative --
/// rendering Item.pickupLat/pickupLng as pins -- publishes an approximate home
/// address for every seller who offers local pickup, and coarsening the pin
/// does not fix it: a 1 km circle around a listing that is renewed weekly from
/// the same house resolves to that house after a few observations. A hub is a
/// different kind of object. Nobody lives at a mall information desk, so its
/// coordinate carries no privacy cost to anyone.
///
/// WHICH IS WHY THESE COORDINATES ARE PRECISE AND PUBLIC, and must stay that
/// way. resolvePickup()'s 2-decimal rounding is a rule about SELLERS' homes and
/// it must never be applied here: a hub rounded to ~1.1 km lands somewhere in
/// the general vicinity of the mall, which is worse than useless to two people
/// trying to find each other, and it protects nobody. If you find yourself
/// reaching for coarsen() on a hub, the bug is the reach, not the precision.
///
/// `landmark` is REQUIRED and has no default, deliberately. "Meet at the mall"
/// is not a meeting point -- a mall has six entrances -- and an optional field
/// here is a field that is empty on the hubs somebody added in a hurry. The
/// admin route makes them type it.
///
/// DEACTIVATION, NOT DELETION. `isActive` false removes a hub from the picker
/// and from GET /api/v1/hubs; it does NOT touch the ItemSafeZone rows pointing
/// at it, and the relation below is Restrict so the database refuses a delete
/// that would. A listing already offered at a hub that closed keeps saying so,
/// flagged unavailable, because the alternative is a listing silently losing
/// the only answer it had to "where would we meet?".
model SafeZoneHub {
  id String @id @default(cuid())

  name String       @db.VarChar(120)
  type SafeZoneType

  address String @db.VarChar(300)

  /// PUBLIC AND PRECISE. See the note above -- never coarsened, never gated.
  latitude  Float
  longitude Float

  /// The LGU, as a plain string rather than an enum: the hub list grows city by
  /// city and adding Consolacion should be an INSERT, not a migration.
  city String @db.VarChar(80)

  /// The "where exactly" note -- "ground floor, near the information desk".
  /// Required; see the note above.
  landmark String @db.VarChar(200)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items ItemSafeZone[]

  /// Trades whose parties CLAIMED they met here. Restrict on that side too, so
  /// a hub carrying meetup history is as undeletable as one carrying listings.
  trades TradeRequest[] @relation("MeetupClaim")

  /// Trades that have ARRANGED to meet here and not yet confirmed. The claim
  /// above is what happened; this is what is planned. Named relations because
  /// there are now two of them between this pair of models -- see the block on
  /// `TradeRequest.meetupHubId` for why they are not one column.
  meetupPlans TradeRequest[] @relation("MeetupPlan")

  /// The picker's query: active hubs in one city. Both filter columns, in the
  /// order the WHERE clause names them.
  @@index([isActive, city])
}

/// Item to hub. "I am willing to meet you at any of these places."
///
/// COMPOSITE PRIMARY KEY rather than a cuid plus a unique index. The pair IS
/// the identity of this row -- there is no such thing as two different
/// associations between the same item and the same hub -- and expressing that
/// as the PK means a double-tapped save cannot produce a duplicate no matter
/// what the route does. It also drops one index and one column off what will be
/// the widest-fanning join in this schema.
///
/// onDelete differs on the two sides, and both directions are deliberate:
///
///   item -> Cascade.  A deleted listing's associations are meaningless and
///                     nothing audits them. Item deletion here is a soft delete
///                     anyway (status = REMOVED), so this fires rarely.
///
///   hub  -> Restrict. The database refuses to delete a hub any listing points
///                     at. This is the enforcement half of "deactivate, never
///                     delete": a hub row deleted out from under its
///                     associations would take the listings' only stated
///                     meeting place with it, and the admin surface exposes no
///                     delete for exactly this reason. Restrict is what makes
///                     the rule hold for somebody at a SQL prompt too.
model ItemSafeZone {
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  hubId String
  hub   SafeZoneHub @relation(fields: [hubId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([itemId, hubId])
  /// "which listings are offered at this hub" -- GET /api/v1/hubs/[id]/items.
  /// The PK's leading column already serves the other direction.
  @@index([hubId])
}
// ── Achievements ─────────────────────────────
//
// A badge an admin defines, and the copy a user earns. The admin surface
// (src/app/admin/achievements) creates and edits the DEFINITION; the criteria
// engine in @/lib/achievements creates the EARNED row automatically when a
// user's activity matches.
//
// ── WHY A CLOSED CRITERION AND NOT A FREE-TEXT RULE ─────────────────────────
//
// `criterion` is an enum, not a script and not a sentence. "Grays out unless
// achieved" is only real if the SYSTEM decides, and the system can only decide
// what it can evaluate -- so the set of things a badge can be earned for is a
// closed list the code knows how to check, exactly like the ID-rejection reason
// list and for the same reason. An admin picks a criterion and a threshold;
// they never type a rule.
//
// `threshold` is read by criterion. For the boolean criteria (VERIFIED,
// PROFILE_COMPLETE, ID_VERIFIED) it is ignored and stored as 1; for the counted
// ones (LISTINGS, TRADES, LIFETIME_LEAVES, SAFEZONE_MEETUPS, REPORTS_FILED) it
// is the number that must be reached. One column for both because a NULL-able
// "threshold that means nothing for this criterion" is a column somebody reads
// and misinterprets.

enum AchievementCriterion {
  // ── THE LIVE VALUES, WHICH ARE THE SOURCE OF TRUTH ─────────────────────────
  //
  // These four are what the live "AchievementCriterion" enum already contained
  // when this surface was built, and there are real Achievement rows using
  // them. The enum here must match the database EXACTLY: Prisma sends these
  // names verbatim, so a value the schema has and the DB lacks fails at runtime
  // with "Value 'X' not found in enum" -- which is precisely the crash that
  // prompted this reconciliation. Do not re-spell them.
  //
  // VERIFIED_ACCOUNT is the mailbox check (User.isVerified), NOT the government
  // ID -- that is ID_VERIFIED, below, and the two are deliberately apart.
  VERIFIED_ACCOUNT
  /// An APPROVED IdVerification (or the grandfather stamp).
  ID_VERIFIED
  /// Items ever posted. Counted.
  FIRST_LISTING
  /// COMPLETED trades, either side. Counted.
  COMPLETED_TRADES
  // ── ADDED BY THIS FEATURE (18 Sep 2026) ─────────────────────
  //
  // Appended to the live enum by 20260919000001_achievement_criterion_values.
  // They extend the closed set @/lib/achievements can evaluate without
  // disturbing the four above.
  /// avatar, bio and location all filled in.
  PROFILE_COMPLETE
  /// User.lifetimeLeaves. Counted.
  LIFETIME_LEAVES
  /// COMPLETED trades that named a SafeZoneHub. Counted.
  SAFEZONE_MEETUPS
  /// Reports filed (a good-citizen badge, not a misconduct one). Counted.
  REPORTS_FILED
  // ── ADDED BY THE SWAN BADGE SET (23 Sep 2026) ────────────────
  //
  // Appended by 20260923000000_achievement_points_and_bridge_criterion.
  /// COMPLETED trades, either side, that carried a bridge fee (TradeRequest
  /// .bridgeFeeLeaves > 0) -- the value gap between two unequal-bracket items
  /// was bridged with Leaves, not just an even swap. Counted, same shape as
  /// COMPLETED_TRADES; see progressFor() in @/lib/achievements.
  BRIDGE_COMPLETED
}

model Achievement {
  id String @id @default(cuid())

  /// Stable machine key ("verified", "first_trade"). Unique, because it is what
  /// code and seed scripts refer to a badge by when the cuid would change
  /// between environments.
  key  String @unique
  name String
  description String @db.Text

  /// Emoji or short text, shown when imageUrl is null. Kept so every badge that
  /// existed before uploaded art still renders.
  icon String @default("🏆")

  /// Uploaded badge art (a public Cloudinary URL from /api/upload). Null falls
  /// back to `icon`.
  imageUrl String?

  criterion AchievementCriterion
  /// The number the criterion must reach. Ignored (stored 1) for booleans.
  threshold Int @default(1)

  /// Admin ordering for the shelf; ties broken by name.
  sortOrder Int @default(0)

  /// How much this badge is worth. Purely a stored number today -- nothing
  /// gates on it and it does not move Leaves -- summed client-side (or by a
  /// future route) into a user's total across their unlocked badges.
  points Int @default(0)

  /// DEACTIVATE, NEVER DELETE. A UserAchievement row points here, and deleting
  /// the definition would cascade away every copy a user earned. Inactive
  /// badges stop being listed and stop being awarded, but the earned rows --
  /// and the users wearing them -- survive.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unlocks UserAchievement[]

  @@index([isActive, sortOrder])
}

/// One user's earned copy of one badge.
///
/// CASCADE from both sides is correct here, unlike Item -> hub: this row is
/// meaningless without both the user and the definition, and there is nothing
/// to audit about it going away (the AdminAction log is about decisions, not
/// about a badge row a user never sees created).
///
/// `displayOrder` is the PROFILE shelf slot (1..4, capped in the route). NULL
/// means "earned but not shown". `homeDisplayOrder` is the single featured slot
/// on the home feed; also NULL when unused. Both live on this row rather than as
/// a list on User because the row is the join, and the join is where the
/// per-achievement display choice belongs.
model UserAchievement {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  /// When the criteria engine granted it. Non-null by definition -- a row only
  /// exists once earned -- so this is not the "is it unlocked" flag; the row's
  /// existence is. Kept because the badge shows "Earned <date>".
  unlockedAt DateTime @default(now())

  /// Profile shelf slot, 1-based. NULL = not displayed. Capped at 4 in
  /// PATCH /api/v1/achievements/display.
  displayOrder Int?

  /// The one home-feed slot. NULL = not featured. At most one non-null per user.
  homeDisplayOrder Int?

  /// ONE EARNED COPY PER (user, achievement). The criteria engine inserts with
  /// skipDuplicates against this constraint, the same claim pattern as
  /// TaskCompletion -- a concurrent award must not write the row twice.
  @@unique([userId, achievementId])
  @@index([userId, displayOrder])
  @@index([achievementId])
}
