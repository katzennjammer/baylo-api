# Baylo API — environment.
#
# Copy this file to `.env` and fill it in:
#
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way. This file is the committed
# template and must never hold a real value.
#
# ─────────────────────────────────────────────────────────────────────────────
#  THE ONLY THING YOU NEED TO RUN THE APP IS DATABASE_URL AND AUTH_SECRET.
# ─────────────────────────────────────────────────────────────────────────────
#
# Everything below those two is a capability. Leave a capability blank and the
# feature that uses it fails; the rest of the app runs. So a new developer can
# be logged in and browsing the seeded feed with two lines filled in, and can
# collect the shared keys afterwards.
#
# Each block below is marked with where its value comes from:
#
#   [YOURS]   You create it. Never ask anyone for this one — it is specific to
#             your machine, or it is a secret you generate yourself.
#   [SHARED]  Ask the project owner. These are accounts the project holds, and
#             a second free-tier signup of your own works just as well if you
#             would rather not wait.
#   [SKIP]    Leave blank. Read the note before deciding otherwise.


# ═════════════════════════════════════════════════════════════════════════════
#  REQUIRED
# ═════════════════════════════════════════════════════════════════════════════

# [YOURS] Your own MariaDB/MySQL, on your own machine. Nobody can give you this
# one and you should not want them to — it points at a database only you use.
#
# The database must EXIST before `prisma migrate deploy` runs; Prisma creates
# tables, not schemas. With XAMPP running:
#
#     "D:\Xampp\mysql\bin\mysql.exe" -u root -e "CREATE DATABASE baylo"
#
# A default XAMPP install has user `root` and no password, which is the empty
# string between `:` and `@` below. If you set a MySQL root password, put it
# there and URL-encode anything exotic (`@` becomes %40).
DATABASE_URL="mysql://root:@127.0.0.1:3306/baylo"

# [YOURS] Signs session tokens. Generate your own — a shared one is a shared
# ability to mint sessions, and it takes one command:
#
#     openssl rand -base64 32
#
# Or, without openssl:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# [YOURS] Where this server is reachable. Leave as-is for local development.
# It is what verification links in emails are built from, so a wrong value here
# produces links that point at the wrong host.
#
# If you are running the mobile client against this server, note that the phone
# cannot reach `localhost` — that is the phone itself. See the mobile repo's
# README; you do not change this line for that, you start Next.js with
# `npm run dev:lan` so it accepts connections from outside the machine.
NEXTAUTH_URL="http://localhost:3000"


# ═════════════════════════════════════════════════════════════════════════════
#  EMAIL  —  [SKIP]
# ═════════════════════════════════════════════════════════════════════════════
#
# LEAVE ALL FIVE BLANK. EMAIL_SMTP_PASS is a personal Gmail app password
# belonging to the project owner; it is tied to their account, it is not a
# project credential, and it is not going to be shared. Do not ask for it.
#
# What blank costs you: verification emails do not send. Nothing else. The send
# is wrapped in a try/catch that logs and moves on (see sendVerificationEmail in
# src/lib/email-verification.ts), so registration still succeeds, and login is
# NOT gated on being verified — an unverified account can sign in and browse.
#
# The one thing an unverified account does not get is the 50-Leaf signup grant,
# which is paid at verification. This is exactly why the seed exists: all four
# seeded accounts are already verified and already granted, so use those to log
# in and ignore this whole section.
#
# If you do want real emails, use YOUR OWN Gmail app password
# (https://myaccount.google.com/apppasswords, requires 2FA on) — never the
# project owner's.
EMAIL_FROM=""
EMAIL_LOGO_URL=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASS=""


# ═════════════════════════════════════════════════════════════════════════════
#  CLOUDINARY  —  [SHARED]        image uploads
# ═════════════════════════════════════════════════════════════════════════════
#
# Ask the project owner, or sign up free at cloudinary.com and use your own —
# the free tier is more than enough and it keeps your test uploads out of the
# shared account.
#
# Blank: browsing works and the seeded listings show their placeholder photos,
# because those are plain Unsplash URLs and never touch Cloudinary. Posting a
# NEW listing with a photo fails at upload.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Government ID verification ───────────────────────────────────────────────
#
# The ID photo goes to Cloudinary as an `authenticated`-type asset in the folder
# `baylo-id-verification`, using the SAME three credentials above. There is
# nothing extra to configure at Cloudinary: delivery type is set per upload by
# the code, not by a folder setting, so an unsigned URL 404s even if it leaks.
# See src/lib/id-verification-image.ts.
#
# DEVELOPMENT ONLY. Set to 1 and a submitted ID is APPROVED on the spot -- the
# image is still destroyed, the cap and the uniqueness rule still apply, and an
# audit row still records what happened. Ignored unless NODE_ENV is not
# "production": the two conditions are independent so that one stray env var
# cannot open the gate on a live deployment.
#
# You are unlikely to need this: the four seeded accounts are grandfathered past
# ID verification and can post without submitting anything.
ID_VERIFICATION_DEV_AUTO_APPROVE="0"


# ═════════════════════════════════════════════════════════════════════════════
#  PUSHER  —  [SHARED]            realtime messages and notifications
# ═════════════════════════════════════════════════════════════════════════════
#
# Ask the project owner, or make a free app at pusher.com (Channels). The two
# NEXT_PUBLIC_ ones are compiled into the browser bundle and are public by
# design; APP_ID and SECRET are server-side and are not.
#
# Blank: chat and notifications stop updating live. Messages still send and are
# still stored — you just have to reload to see them.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"


# ═════════════════════════════════════════════════════════════════════════════
#  ANTHROPIC  —  [SHARED]         AI valuation, duplicate-photo confirmation
# ═════════════════════════════════════════════════════════════════════════════
#
# Ask the project owner, or use your own key from console.anthropic.com. This
# one costs money per call, so prefer your own if you are going to hammer it.
#
# Blank: the AI half of the valuation and duplicate-photo checks fails. The
# comparables/band valuation in src/lib/valuation.ts is pure arithmetic and
# keeps working without it — and the seed puts four settled electronics items
# in the database precisely so that path has real data to run on.
ANTHROPIC_API_KEY=""

# Duplicate-photo detection tuning. Both have working defaults; set them only if
# you are actually tuning the detector.
#   PHASH_THRESHOLD   dHash distance that counts as a match. Default 10.
#                     Renamed/recompressed copies land at 0-8, unrelated images
#                     at 20+. Lower it if you see false positives.
#   DUPLICATE_ACTION  what a confirmed duplicate does: block | warn | flag.
#                     Default "block".
# PHASH_THRESHOLD="10"
# DUPLICATE_ACTION="block"


# ═════════════════════════════════════════════════════════════════════════════
#  GOOGLE OAUTH  —  [SHARED]      "Continue with Google"
# ═════════════════════════════════════════════════════════════════════════════
#
# Ask the project owner, or create your own OAuth client in the Google Cloud
# console. If you make your own, the authorised redirect URI must be exactly:
#
#     http://localhost:3000/api/auth/callback/google
#
# Blank: the Google button fails. Email-and-password sign-in is unaffected, and
# the seeded accounts are password accounts — so this is safe to skip entirely
# until you specifically need to work on Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated Android/iOS OAuth client ids that the MOBILE app may present.
#
# THIS IS THE BACKEND HALF OF NATIVE GOOGLE SIGN-IN and it lives here, not in
# the mobile repo's .env. The native app sends an ID token whose `aud` claim is
# its own platform client id; POST /api/auth/google/token only accepts audiences
# listed here (plus GOOGLE_CLIENT_ID above), so if this is empty the exchange
# 401s no matter how correctly the app is configured.
#
# Only relevant if you are working on mobile Google sign-in, which additionally
# requires a dev build — it does not work in Expo Go. See ../baylo-mobile.
GOOGLE_NATIVE_CLIENT_IDS=""
